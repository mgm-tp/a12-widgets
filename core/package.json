{
	"name": "@com.mgmtp.a12.widgets/widgets-core",
	"version": "38.3.3",
	"description": "Collection of widgets",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"scripts": {
		"clean": "rimraf ./target ./lib/** ./playwright-report ./test-results ../json-api/core",
		"lint:eslint": "eslint --quiet --cache --cache-location target/.eslintcache",
		"test": "pnpm --sequential \"/^test:.*/\"",
		"test:unit": "vitest --run",
		"test:api": "api-extractor run --print-api-report-diff",
		"update:api": "api-extractor run --local",
		"compile": "pnpm \"/^compile:.*/\"",
		"compile:typedoc": "node --max-old-space-size=4096 ./node_modules/typedoc/bin/typedoc --tsconfig tsconfig.build.json",
		"compile:typescript": "node --max-old-space-size=4096 ./node_modules/typescript/lib/tsc.js --project tsconfig.build.json",
		"compile:copyfonts": "cpy theme/fonts ../../lib --cwd=src",
		"compile:copytypes": "cpy @types ../../lib --cwd=src",
		"compile:copycss": "cpy theme/basic.css rich-text-editor/main/themes/rich-text-editor.css ../../lib --cwd=src",
		"postcompile:typedoc": "node scripts/generate-json-api.mjs",
		"start": "pnpm \"/^start:.*/\"",
		"start:typescript": "pnpm compile:typescript --watch --preserveWatchOutput",
		"open:playwright": "pnpm test:playwright --ui",
		"pretest": "pnpm exec playwright install chromium --only-shell",
		"test:playwright": "playwright test -c playwright-ct.config.ts",
		"sbom": "cyclonedx-pnpm > cyclonedx.json"
	},
	"author": "mgm technology partners",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"dependencies": {
		"@date-fns/tz": "^1.4.1",
		"@emotion/is-prop-valid": "^1.4.0",
		"@lexical/html": "^0.31.2",
		"@lexical/link": "^0.31.2",
		"@lexical/list": "^0.31.2",
		"@lexical/plain-text": "^0.31.2",
		"@lexical/react": "^0.31.2",
		"@lexical/rich-text": "^0.31.2",
		"@lexical/selection": "^0.31.2",
		"@lexical/utils": "^0.31.2",
		"@react-dnd/shallowequal": "^4.0.2",
		"@types/lodash": "^4.17.21",
		"@tanstack/react-virtual": "^3.13.18",
		"@types/react-virtualized": "^9.22.3",
		"@types/scheduler": "0.23.0",
		"date-fns": "^4.1.0",
		"deepmerge": "^4.3.1",
		"detect-it": "4.0.1",
		"dnd-core": "^16.0.1",
		"dnd-multi-backend": "9.0.1-rc0001",
		"dompurify": "^3.3.3",
		"framer-motion": "12.25.0",
		"immer": "^10.2.0",
		"lexical": "^0.31.2",
		"linkify-it": "^5.0.0",
		"lodash-es": "^4.18.1",
		"mini-svg-data-uri": "^1.4.4",
		"mobile-detect": "^1.4.5",
		"polished": "^4.3.1",
		"react-day-picker": "^9.6.7",
		"react-dnd-html5-backend": "^16.0.1",
		"react-dnd-touch-backend": "^16.0.1",
		"react-draggable": "^4.5.0",
		"react-lines-ellipsis": "^0.15.3",
		"react-resize-detector": "^12.3.0",
		"react-rnd": "^10.5.3",
		"react-scroll": "^1.9.3",
