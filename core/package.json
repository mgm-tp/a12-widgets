{
	"name": "@com.mgmtp.a12.widgets/widgets-core",
	"version": "39.0.3",
	"description": "Collection of widgets",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"scripts": {
		"clean": "rimraf ./target ./lib ./test-results ../json-api/core",
		"lint:eslint": "eslint --quiet --cache --cache-location target/.eslintcache",
		"test": "pnpm \"/^test:.*/\"",
		"test:unit": "vitest --run",
		"test:api": "api-extractor run --print-api-report-diff",
		"update:api": "api-extractor run --local",
		"compile": "pnpm \"/^compile:.*/\"",
		"compile:typedoc": "node scripts/generate-json-api.js",
		"compile:typescript": "node --max-old-space-size=3072 ./node_modules/typescript/lib/tsc.js --project tsconfig.build.json",
		"compile:copyfonts": "cpy theme/fonts ../lib --cwd=src",
		"compile:copytypes": "cpy @types ../lib/ --cwd=src",
		"compile:copycss": "cpy theme/basic.css rich-text-editor/main/themes/rich-text-editor.css ../lib --cwd=src",
		"start": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
		"pretest:unit": "pnpm exec playwright install chromium"
	},
	"author": "mgm technology partners",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^1.4.0",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.0.3",
		"@date-fns/tz": "catalog:",
		"@emotion/is-prop-valid": "^1.4.0",
		"@lexical/html": "catalog:",
		"@lexical/link": "catalog:",
		"@lexical/list": "catalog:",
		"@lexical/plain-text": "catalog:",
		"@lexical/react": "catalog:",
		"@lexical/rich-text": "catalog:",
		"@lexical/selection": "catalog:",
		"@lexical/utils": "catalog:",
		"@react-dnd/shallowequal": "^4.0.2",
		"@tanstack/react-virtual": "^3.13.24",
		"@types/lodash": "^4.17.24",
		"@types/react-virtualized": "catalog:",
		"@types/scheduler": "0.26.0",
		"date-fns": "catalog:",
		"deepmerge": "catalog:",
		"detect-it": "4.0.1",
		"dnd-core": "^16.0.1",
		"dnd-multi-backend": "9.0.1-rc0001",
		"dompurify": "catalog:",
		"immer": "catalog:",
		"lexical": "catalog:",
		"linkify-it": "^5.0.0",
		"lodash-es": "catalog:",
		"mini-svg-data-uri": "^1.4.4",
		"mobile-detect": "catalog:",
		"motion": "^12.42.2",
		"polished": "catalog:",
		"react-day-picker": "^9.14.0",
		"react-dnd-html5-backend": "catalog:",
		"react-dnd-touch-backend": "^16.0.1",
		"react-draggable": "^4.5.0",
		"react-lines-ellipsis": "^0.16.1",
		"react-resize-detector": "^12.3.0",
		"react-rnd": "^10.5.3",
		"react-scroll": "^1.9.3",
		"react-transition-group": "catalog:",
		"react-virtualized": "catalog:",
		"recharts": "catalog:",
		"scheduler": "^0.27.0",
		"ts-key-enum": "catalog:"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.58.9",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/linkify-it": "^5.0.0",
		"@types/lodash-es": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/react-scroll": "^1.8.10",
		"@types/react-transition-group": "catalog:",
		"@types/stylis": "^4.2.7",
		"@typescript/native-preview": "latest",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/ui": "catalog:",
		"cpy-cli": "^7.0.0",
		"jest-styled-components": "^7.4.0",
		"minimatch": "^10.2.5",
		"playwright": "^1.60.0",
		"react": "catalog:",
		"react-dnd": "catalog:",
		"react-dnd-test-backend": "^16.0.1",
		"react-dom": "catalog:",
		"rimraf": "catalog:",
		"styled-components": "catalog:",
		"stylis": "^4.4.0",
		"typedoc": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"react": "^19.2.6",
		"react-dnd": "^16.0.1",
		"react-dom": "^19.2.6",
		"styled-components": "^6.1.18"
	},
	"files": [
		"lib",
		"src",
		"patches",
		"cyclonedx.json",
		"CHANGELOG.md",
		"!**/*/__tests__/",
		"LICENSE",
		"NOTICE",
		"THIRD_PARTY_NOTICES",
		"licenses"
	],
	"browserslist": [
		"last 2 firefox versions",
		"Firefox ESR",
		"last 2 chrome versions",
		"last 2 edge versions",
		"last 2 ios versions",
		"last 2 Safari versions",
		"last 2 ChromeAndroid versions"
	],
	"type": "module",
	"exports": {
		".": "./lib/index.js",
		"./experimental": {
			"types": "./lib/experimental-entry.d.ts",
			"default": "./lib/experimental-entry.js"
		},
		"./types/*": {
			"types": "./lib/@types/*/index.d.ts"
		},
		"./styles/basic.css": "./lib/theme/basic.css",
		"./styles/rich-text-editor.css": "./lib/rich-text-editor/main/themes/rich-text-editor.css",
		"./package.json": "./package.json",
		"./CHANGELOG.md": "./CHANGELOG.md"
	},
	"sideEffects": [
		"**/*.css"
	]
}
