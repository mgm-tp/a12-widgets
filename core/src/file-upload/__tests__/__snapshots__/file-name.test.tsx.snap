  max-width: 100%;
  vertical-align: middle;
}

.c14 {
  background-position: -10000% bottom;
  background-repeat: no-repeat;
  background-size: calc(100% - 1px) calc(0.1rem);
  color: rgb(5, 104, 174);
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
