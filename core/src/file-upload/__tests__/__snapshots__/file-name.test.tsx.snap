<div
  class="c0 c1 field field__upload--fit"
  data-role="file-upload"
>
  <div>
    <label
      class="c2 c3 label field__label"
      data-disabled="false"
      data-role="file-upload-label"
      id="test-id-label"
    >
      Test File Name
    </label>
    <div
      class="c4 message message--warning"
      data-role="file-upload-warning-message"
      id="test-id-warning"
    >
      <div
        class="c5 messageIcon"
      >
        <i
          class="c6 c7 c8 plasma-icon plasma-icon--warning"
          data-role="plasma-icon"
          title="Warning"
        >
          <span
            aria-hidden="true"
          >
            warning
          </span>
          <span
            class="c9 -u-unseenButRead"
            data-role="hidden-text"
          >
            Warning
          </span>
        </i>
      </div>
      <div
        class="c10 messageText"
        data-role="warning-text"
      >
        Test Warning Message
      </div>
    </div>
  </div>
  <div
    class="c11 c12 field__upload field__upload--warning field__upload--placeholder"
    data-role="file-upload-control"
  >
    <div
      aria-describedby="test-id-label test-id-warning"
      aria-disabled="false"
      class="c13 field__upload-content"
      data-role="file-upload-content"
      id="test-id-content"
      tabindex="0"
      title="Upload file"
    >
      <a
        class="c14 link c15 c16 -u-truncate"
        data-role="link"
        href="#"
        tabindex="0"
      >
        <i
          class="c6 c17 plasma-icon plasma-icon--custom"
          data-role="plasma-icon"
          title="Datatype PDF"
        >
          <span
            aria-hidden="true"
          >
            
          </span>
          <span
            class="c9 -u-unseenButRead"
            data-role="hidden-text"
          >
            Datatype PDF
          </span>
        </i>
        <span
          data-role="file-upload-visible-text"
          id="test-id-content-visible-text"
        >
          Test File.pdf
        </span>
      </a>
      <span
        class="c9 -u-unseenButRead"
        data-role="hidden-text"
        id="test-id-upload-button-title"
      >
        Upload file
      </span>
      <input
        class="c18 field__upload-input"
        data-role="file-upload-input"
        id="test-id"
        tabindex="-1"
        type="file"
      />
    </div>
  </div>
</div>
