}

.c13 [data-role="file-upload-content-inner"] {
  pointer-events: none;
}

.c13 {
  justify-content: flex-start;
}

.c13 svg {
  pointer-events: none;
}

.c13:focus::before {
  content: "";
  inset: 0px;
  position: absolute;
  outline: rgb(51, 51, 51) dotted 1px;
  border-radius: inherit;
}

.c13:focus::before {
  border: 2px solid rgb(213, 0, 117);
}

.c1 {
