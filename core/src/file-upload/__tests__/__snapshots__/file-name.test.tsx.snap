  vertical-align: -2px;
}

.c14:visited {
  color: rgb(5, 104, 174);
}

.c14:focus {
  background-image: linear-gradient(rgb(213, 0, 117), rgb(213, 0, 117));
  background-position: left bottom;
  color: rgb(213, 0, 117);
  outline: rgb(51, 51, 51) dotted 1px;
  text-decoration: none;
}

.c12 {
  display: flex;
  min-width: 48px;
