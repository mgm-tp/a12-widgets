.c14 {
  font-size: 1.5rem;
}

.c15 {
  box-sizing: border-box;
  flex: 0 1 auto;
  padding: 0px 16px 16px;
}

.c16 {
  color: rgb(77, 77, 77);
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  line-height: 1.45;
}

.c1 {
  box-sizing: border-box;
  position: fixed;
  padding: 4px 4px 8px 8px;
  outline: none;
  width: 496px;
  max-width: calc(100% - 16px);
  isolation: isolate;
  max-height: 100%;
  overflow-y: auto;
}

.c1 .c4 {
  margin: 4px 0px;
  pointer-events: auto;
  width: 100%;
}

.c1 .c9 {
  flex: 1 1 0%;
}

.c2 {
  display: flex;
  flex-direction: column;
}

.c2 .toast-enter {
  animation: 0.2s ease 0s 1 normal none running k0;
}

.c2 .toast-stacked-enter {
  animation: 0.5s ease 0s 1 normal none running k0;
}

.c2 .toast-exit {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  overflow: hidden;
  margin: 0px;
  transition: 0.35s 0.25s;
}

.c2 .toast-exit * {
  margin: 0px;
  padding: 0px;
  transition: margin 0.2s 0.25s, padding 0.2s;
}

.c2 .toast-stacked-exit {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  overflow: hidden;
  margin: 0px;
  transition: 0.35s 0.25s;
}

.c2 .toast-stacked-exit * {
  margin: 0px;
  padding: 0px;
  transition: margin 0.5s 0.25s, padding 0.5s;
}

.c2 .toast-exit-active {
  animation: 0.35s ease 0s 1 normal forwards running k1;
}

.c2 .toast-stacked-exit-active {
  animation: 0s ease 0s 1 normal forwards running k1;
}

.c3:nth-last-child(2):not(.toast-exit) {
  transition: visibility linear 0.35s, opacity 0.35s;
}

@media (pointer: coarse) {
  .c13:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: transparent;
    box-shadow: none;
    color: rgb(213, 0, 117);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c13:not(:disabled):hover {
    background-color: transparent;
    box-shadow: none;
    color: rgb(213, 0, 117);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c13:hover {
    outline: transparent solid 1px;
  }
}

@keyframes k1 {
  0% {
    max-height: 9999px;
    opacity: 1;
  }

  100% {
    max-height: 0px;
    opacity: 0;
  }
}

@keyframes k0 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

