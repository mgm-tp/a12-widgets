exports[`com.mgmtp.a12.widgets.counter > render interactive counter 1`] = `
.c1 {
  border: 0px;
  clip: rect(0px, 0px, 0px, 0px);
  clip-path: inset(100%);
  height: 1px;
  min-height: 1px;
  overflow: hidden;
  padding: 0px;
  position: absolute;
  top: 0px;
  width: 1px;
  margin: -1px !important;
}

.c1 * {
  width: 1px;
  height: 1px;
}

.c0 {
  align-items: center;
  background-color: rgb(183, 192, 199);
  border-radius: 8px;
  color: rgb(77, 77, 77);
  display: inline-flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  justify-content: center;
  outline: transparent solid 1px;
  padding: 0px 5px;
  vertical-align: middle;
  cursor: pointer;
}

.c0 > * {
  flex-shrink: 0;
}

.c0:focus {
  background-color: rgb(213, 0, 117);
  color: rgb(255, 255, 255);
  outline: rgb(51, 51, 51) dotted 1px;
}

.c2 {
  height: auto;
  line-height: 1rem;
  margin: 0px;
  padding: 0px;
  animation: 0.5s ease 0s 1 normal none running k0, 0.5s ease 0s 1 normal none running k1;
}

@media (pointer: coarse) {
  .c0:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(213, 0, 117);
    color: rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c0:hover {
    background-color: rgb(213, 0, 117);
    color: rgb(255, 255, 255);
  }
}

@keyframes k0 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

@keyframes k1 {
  0% {
    transform: translate3d(0px, 3px, 0px);
  }

  100% {
    transform: translateZ(0px);
  }
}

@keyframes k2 {
  0% {
    transform: translate3d(0px, -3px, 0px);
  }

  100% {
    transform: translateZ(0px);
  }
}

<span
  class="c0 counter counter--interactive"
  data-role="counter"
  role="button"
  tabindex="0"
>
  <span
    class="c1 -u-unseenButRead"
    data-role="hidden-text"
  >
    23 Entries
  </span>
  <span
    aria-hidden="true"
    role="presentation"
  >
    <span
      class="c2 counter__item"
    >
      2
    </span>
    <span
      class="c2 counter__item"
    >
      3
    </span>
  </span>
</span>
`;

