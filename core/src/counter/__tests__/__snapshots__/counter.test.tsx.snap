  align-items: center;
  background-color: rgb(183, 192, 199);
  border-radius: 8px;
  color: rgb(77, 77, 77);
  display: inline-flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  justify-content: center;
  outline: transparent solid 1px;
  padding: 0px 5px;
  vertical-align: middle;
}

.c0 > * {
  flex-shrink: 0;
}

.c2 {
  height: auto;
  line-height: 1rem;
  margin: 0px;
  padding: 0px;
  animation: 0.5s ease 0s 1 normal none running k0, 0.5s ease 0s 1 normal none running k1;
}

@keyframes k0 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

@keyframes k1 {
