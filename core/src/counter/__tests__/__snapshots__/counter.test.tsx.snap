  </span>
</span>
`;

exports[`com.mgmtp.a12.widgets.counter > render counter with addon 1`] = `
.c4 {
  border: 0px;
  clip: rect(0px, 0px, 0px, 0px);
  clip-path: inset(100%);
  height: 1px;
  min-height: 1px;
  overflow: hidden;
  padding: 0px;
  position: absolute;
  top: 0px;
  width: 1px;
  margin: -1px !important;
}

.c4 * {
  width: 1px;
  height: 1px;
}

.c3 {
  box-sizing: border-box;
  color: rgb(127, 140, 155);
  display: inline-block;
  direction: ltr;
  font-family: "Material Icons";
  font-size: 1rem;
  font-style: normal;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 1;
  text-transform: none;
  white-space: nowrap;
  overflow-wrap: normal;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizelegibility;
  font-feature-settings: "liga";
}

.c3 > span {
  display: inline-block;
}

.c3.c3 {
  max-width: unset;
}

.c0 {
  align-items: center;
  background-color: rgb(183, 192, 199);
  border-radius: 8px;
  color: rgb(77, 77, 77);
  display: inline-flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  justify-content: center;
  outline: transparent solid 1px;
  padding: 0px 5px;
  vertical-align: middle;
}

.c0 > * {
  flex-shrink: 0;
}

.c1 {
  display: inline-flex;
  margin-right: 2px;
}

.c1 > * {
  flex-shrink: 0;
}

.c1 .c2 {
  color: inherit;
}

.c6 {
  display: inline-flex;
  margin-left: 2px;
}

.c6 > * {
  flex-shrink: 0;
}

.c6 .c2 {
  color: inherit;
}

.c5 {
  height: auto;
  line-height: 1rem;
  margin: 0px;
  padding: 0px;
  animation: 0.5s ease 0s 1 normal none running k0, 0.5s ease 0s 1 normal none running k1;
}

@keyframes k0 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

@keyframes k1 {
  0% {
    transform: translate3d(0px, 3px, 0px);
  }

  100% {
    transform: translateZ(0px);
  }
}

@keyframes k2 {
  0% {
    transform: translate3d(0px, -3px, 0px);
  }

  100% {
    transform: translateZ(0px);
  }
}

<span
  class="c0 counter"
  data-role="counter"
>
  <span
    class="c1 counter__addon counter__addon--before"
    data-role="counter-addon"
  >
    <i
      class="c2 c3 plasma-icon"
      data-role="plasma-icon"
    >
      <span
        aria-hidden="true"
      >
        done
      </span>
    </i>
  </span>
  <span
    class="c4 -u-unseenButRead"
    data-role="hidden-text"
  >
    23 Entries
  </span>
  <span
    aria-hidden="true"
    role="presentation"
  >
    <span
      class="c5 counter__item"
    >
      2
    </span>
    <span
      class="c5 counter__item"
    >
      3
    </span>
  </span>
  <span
    class="c6 counter__addon counter__addon--after"
  >
    <i
      class="c2 c3 plasma-icon"
      data-role="plasma-icon"
    >
      <span
        aria-hidden="true"
      >
        error
      </span>
    </i>
  </span>
</span>
`;

