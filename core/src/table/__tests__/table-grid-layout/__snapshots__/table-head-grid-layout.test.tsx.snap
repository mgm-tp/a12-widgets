  display: block;
  left: 0px;
  position: absolute;
  right: 0px;
  top: 0px;
}

.c51 ::after {
  content: "";
  top: 0px;
  right: 0px;
  bottom: 0px;
  position: absolute;
  display: block;
  left: unset;
  border-right: 2px solid rgb(255, 255, 255);
}

.c75 {
  border-left: 1px solid rgb(241, 242, 244);
  border-right: 1px solid rgb(241, 242, 244);
  margin-top: -1px;
}

.c76 {
  overflow-x: auto;
}

@media (pointer: fine) {
  .c58:hover {
    background-color: rgb(249, 250, 251);
  }
}

@media (pointer: coarse) {
  .c58:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(249, 250, 251);
  }
}

@media (pointer: coarse) {
  .c58:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    box-shadow: none;
  }
}

@media (pointer: fine) {
  .c58:hover {
    box-shadow: none;
  }
}

@media (pointer: coarse) {
  .c58:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }
}

@media (pointer: fine) {
  .c56:not(:focus):hover .c60:last-child > :last-child::before {
    border-right: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: coarse) {
  .c12:not([data-headcell-no-effect="true"]):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    color: rgb(213, 0, 117);
  }

  .c12:not([data-headcell-no-effect="true"]):active::before {
    border-bottom: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c12:not([data-headcell-no-effect="true"]):hover {
    color: rgb(213, 0, 117);
  }

  .c12:not([data-headcell-no-effect="true"]):hover::before {
    border-bottom: 2px solid rgb(213, 0, 117);
  }
}

