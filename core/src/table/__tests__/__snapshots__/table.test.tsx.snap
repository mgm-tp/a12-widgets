  min-height: 26px;
  position: relative;
  padding: 2px 8px;
}

.c10:focus {
  outline: none;
}

.c11 .c10.c10 {
  overflow: hidden;
}

.c6:first-child .c10.c10.c10:first-child[data-role*="group-parent"] {
  min-width: 100%;
}

.c4 {
  border-bottom: 1px solid rgb(211, 214, 220);
  overflow: hidden;
  background-color: rgb(241, 242, 244);
}

.c2 {
  background-color: rgb(241, 242, 244);
  border-left: 1px solid rgb(241, 242, 244);
  border-right: 1px solid rgb(241, 242, 244);
  flex: 0 0 auto;
}

.c0 {
  color: rgb(77, 77, 77);
  display: flex;
  height: 100%;
  outline: none;
  position: relative;
}

.c0 .c13:not(:empty) {
  flex-grow: 0;
}

.c0 .c25 {
  display: flex;
  flex-grow: 1;
  flex-direction: column;
}

.c0 .c27:last-child {
  flex-grow: 1;
}

.c1 {
  display: flex;
  flex-direction: column;
  width: 100%;
  position: relative;
  isolation: isolate;
}

.c1[data-table-container-resizing="true"] .c8 {
  cursor: col-resize;
  user-select: none;
}

.c29 {
  border-left: 1px solid rgb(241, 242, 244);
  border-right: 1px solid rgb(241, 242, 244);
  margin-top: -1px;
}

.c30 {
  overflow-x: auto;
}

@media (pointer: coarse) {
  .c16:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }
}

@media (pointer: coarse) and (any-hover: none) {
  .c16:not(:focus):active::before {
    border-width: medium medium 1px;
    border-style: none none solid;
    border-color: currentcolor currentcolor rgb(211, 214, 220);
    border-image: none;
    box-sizing: border-box;
  }

  .c16:not(:focus):active::after {
    box-sizing: border-box;
  }
}

@media (pointer: fine) {
  .c15:not(:focus):hover .c17:last-child > :last-child::before {
    border-right: 2px solid rgb(213, 0, 117);
  }
}

