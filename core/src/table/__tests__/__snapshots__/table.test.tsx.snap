exports[`com.mgmtp.a12.widgets.table > specific alignment 1`] = `
.c3 {
  display: flex;
  position: relative;
}

.c9 {
  box-sizing: border-box;
  display: flex;
  flex: 10 1 auto;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  min-width: 150px;
  padding: 8px;
  text-align: left;
  width: 150px;
  overflow-wrap: break-word;
  word-break: break-word;
}

.c9 p:first-child {
  margin-top: 0px;
}

.c9 p:last-child {
  margin-bottom: 0px;
}

.c5:first-child .c9.c9:first-child {
  min-width: calc(166px);
  width: calc(166px);
  padding-left: calc(24px);
}

[data-role="tree"] .c5:first-child .c9.c9:first-child.c5:first-child .c9.c9:first-child {
  padding-left: calc(24px);
}

.c7 {
  display: flex;
  position: relative;
  flex: 1 1 0%;
  overflow: hidden;
}

.c16 {
  line-height: 1.45;
  outline: none;
  overflow: hidden;
  position: relative;
  background-color: rgb(255, 255, 255);
}

.c16::before,
.c16::after {
  bottom: 0px;
  left: 0px;
  position: absolute;
  top: 0px;
  content: "";
  pointer-events: none;
}

.c16::before {
  right: 0px;
}

.c16::after {
  display: block;
}

.c16:focus {
  background-color: rgb(249, 250, 251);
}

.c16:active,
.c16:focus-within {
  background-color: rgb(249, 250, 251);
}

.c15:focus .c17:last-child > :last-child {
  background-clip: unset;
}

.c15:focus .c17:last-child > :last-child::before {
  border-right: 2px solid rgb(213, 0, 117);
  margin-right: 1px;
}

.c18 {
  min-height: 32px;
  overflow: hidden;
  isolation: isolate;
  flex-direction: column;
  justify-content: center;
}

[data-role="tree"] .c18.c18 {
  padding: 8px;
}

.c18.c18 > * {
  align-self: center;
}

.c18.c18 {
  text-align: center;
}

.c18 [class*="field--block"] {
  flex-grow: 0;
}

.c19 {
  min-height: 32px;
  overflow: hidden;
  flex-direction: column;
  justify-content: center;
}

[data-role="tree"] .c19.c19 {
  padding: 8px;
}

.c19.c19 > * {
  align-self: center;
}

.c19.c19 {
  text-align: center;
}

.c19 [class*="field--block"] {
  flex-grow: 0;
}

.c14 {
  border-width: 1px 1px medium;
  border-style: solid solid none;
  border-color: rgb(241, 242, 244) rgb(241, 242, 244) transparent;
  border-image: none;
  outline: none;
}

.c14:focus {
  border: 1px dotted rgb(51, 51, 51);
}

.c14:not(:empty) {
  flex: 1 1 auto;
  overflow-x: hidden;
}

.c23 {
  font-weight: 600;
  min-height: 32px;
  overflow: hidden;
  justify-content: flex-start;
  text-align: left;
  align-items: flex-start;
}

.c23:empty {
  min-height: 1px;
  padding-top: 0px;
  padding-bottom: 0px;
}

.c21 {
  border-left: 1px solid rgb(241, 242, 244);
  border-right: 1px solid rgb(241, 242, 244);
  flex: 0 0 auto;
  overflow: hidden;
  z-index: 1;
}

.c21 > * {
  position: relative;
}

.c21 > ::before {
  content: "";
  inset: 0px;
  position: absolute;
  border-bottom: 1px solid rgb(211, 214, 220);
}

.c21 > :first-child {
  box-shadow: rgb(226, 230, 233) 0px 1px 0px 0px inset, rgb(169, 179, 188) 0px 2px 0px 0px inset;
}

.c21 > :first-child::before {
  border-bottom-width: medium;
  border-bottom-style: none;
  border-bottom-color: currentcolor;
}

.c12 {
  align-items: center;
  display: flex;
  flex-grow: 1;
  flex-wrap: wrap;
  line-height: normal;
  min-height: 22px;
  justify-content: flex-end;
  text-align: right;
}

.c10 {
  color: rgb(77, 77, 77);
  cursor: default;
  font-size: 0.75rem;
  font-weight: 600;
  min-height: 26px;
  position: relative;
  padding: 2px 8px;
  align-items: flex-end;
}

.c10:focus {
