  height: 100%;
  outline: none;
  position: relative;
}

.c0 .c28:not(:empty) {
  flex-grow: 0;
}

.c0 .c30 {
  display: flex;
  flex-grow: 1;
  flex-direction: column;
}

.c0 .c32:last-child {
  flex-grow: 1;
}

.c37 {
  cursor: col-resize;
  height: 100%;
  padding: 0px 8px;
  position: absolute;
  top: 0px;
  visibility: hidden;
}

.c37 div {
  background-color: rgb(181, 76, 23);
  height: 100%;
  width: 2px;
}

.c36 {
  cursor: col-resize;
  height: 100%;
  position: absolute;
  visibility: hidden;
  width: 100%;
}

.c1 {
  display: flex;
  flex-direction: column;
  width: 100%;
  position: relative;
  isolation: isolate;
}

.c1[data-table-container-resizing="true"] .c12 {
  cursor: col-resize;
  user-select: none;
}

.c20 {
  cursor: col-resize;
  height: 100%;
  padding: 0px 8px;
  position: absolute;
  top: 0px;
  left: calc(-10px);
}

.c20 div {
  -webkit-user-drag: element;
  background-color: rgb(255, 255, 255);
  height: 100%;
  width: 2px;
}

.c20[data-resize-handler-hover="true"] div {
  background-color: rgb(181, 76, 23);
}

.c21 {
  cursor: col-resize;
  height: 100%;
  padding: 0px 8px;
  position: absolute;
  top: 0px;
  right: -8px;
}

.c21 div {
  -webkit-user-drag: element;
  background-color: rgb(255, 255, 255);
  height: 100%;
  width: 2px;
}

.c21[data-resize-handler-hover="true"] div {
  background-color: rgb(181, 76, 23);
}

.c34 {
  border-left: 1px solid rgb(241, 242, 244);
  border-right: 1px solid rgb(241, 242, 244);
  margin-top: -1px;
}

.c35 {
  overflow-x: auto;
}

@media (pointer: coarse) {
  .c20:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c20:active div {
    background-color: rgb(181, 76, 23);
  }
}

@media (pointer: fine) {
  .c20:hover div {
    background-color: rgb(181, 76, 23);
  }
}

@media (pointer: coarse) {
