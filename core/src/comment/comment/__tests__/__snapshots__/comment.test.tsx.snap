exports[`com.mgmtp.a12.widgets.comment.comment > rendering-action-buttons-comment 1`] = `
.c5 {
  align-items: center;
  cursor: pointer;
  display: inline-flex;
  justify-content: center;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  gap: 4px;
  outline: none;
  text-transform: uppercase;
  min-height: 32px;
  vertical-align: middle;
  border: 2px solid transparent;
  border-radius: 0px;
  padding: 0px 8px;
  position: relative;
  background: transparent;
  color: rgb(5, 104, 174);
}

.c5:not(:disabled):focus {
  outline: rgb(51, 51, 51) dotted 1px;
  background-color: rgb(255, 255, 255);
  box-shadow: none;
  color: rgb(213, 0, 117);
  text-decoration: none;
  border: 2px solid rgb(213, 0, 117);
}

.h_inlineBlock.h_middleAlign .c5.c5 {
  display: block;
  height: auto;
  min-height: 0px;
}

.c4 {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  order: 1;
  flex-grow: 1;
  justify-content: flex-end;
}

.c0 {
  display: flex;
  flex-direction: column;
  padding: 16px 8px 16px 16px;
  overflow-x: auto;
  text-size-adjust: none;
}

.c1 {
  align-items: center;
  display: flex;
  margin: 0px 24px 8px;
}

.c2 {
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  overflow-x: auto;
  padding: 4px 24px;
}

.c2 > :not(:last-child) {
  margin: 0px 0px 8px;
}

.c3 {
  height: fit-content;
  margin: 4px 0px 0px 24px;
}

@media (pointer: coarse) {
  .c5:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c5:not(:disabled):hover {
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c5:hover {
    outline: transparent solid 1px;
  }
}

<div
  class="c0 comment"
  data-role="comment"
>
  <div
    class="c1 comment__meta-container"
  />
  <div
    class="c2 comment__content"
  />
  <div
    class="c3 comment__actions"
    data-role="comment-actions"
  >
    <div
      class="c4 button-group h_floatRight button-group--right "
      data-role="button-group"
    >
      <button
        class="c5 button button--secondary"
        data-role="button"
        title=""
        type="button"
      >
        <span
          data-role="button-label"
        >
          Reply
        </span>
      </button>
      <button
        class="c5 button button--secondary"
        data-role="button"
        title=""
        type="button"
      >
        <span
          data-role="button-label"
        >
          Delete
        </span>
      </button>
    </div>
  </div>
</div>
`;

