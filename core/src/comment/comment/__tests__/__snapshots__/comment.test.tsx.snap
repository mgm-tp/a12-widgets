  height: 16px;
  left: -20px;
  position: absolute;
  width: 16px;
}

.c5 {
  display: inline;
  font-weight: 600;
  margin: 0px 4px 0px 0px;
}

.c0 {
  display: flex;
  flex-direction: column;
  padding: 16px 8px 16px 16px;
  overflow-x: auto;
  text-size-adjust: none;
}

.c0 .c4,
.c0 .c6,
.c0 .c8 {
  color: rgb(97, 111, 124);
}

.c1 {
  align-items: center;
  display: flex;
  margin: 0px 24px 8px;
}

.c7 {
  color: rgb(97, 111, 124);
  display: inline-block;
  margin: 0px 4px 0px 0px;
}

.c9 {
  color: rgb(97, 111, 124);
  display: inline-block;
}

.c10 {
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  overflow-x: auto;
  padding: 4px 24px;
}

.c10 > :not(:last-child) {
  margin: 0px 0px 8px;
}

@media (pointer: coarse) {
  .c12:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c12:not(:disabled):hover {
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c12:hover {
    outline: transparent solid 1px;
  }
}

<div
  class="c0 comment comment--inactive comment--minimised"
  data-role="comment"
>
  <div
    class="c1 comment__meta-container"
  >
    <div
      class="c2 comment__meta"
      data-role="comment-meta"
    >
      <div
        class="c3 comment__meta-avatar"
      >
        avatar
      </div>
      <div
        class="c4 c5 comment__meta-author"
      >
        Matt
      </div>
      <div
        class="c6 c7 comment__meta-action"
      >
        wrote
      </div>
      <div
        class="c8 c9 comment__meta-date"
      >
        Fri, 16 Dec 2022 20:24:00 GMT
      </div>
    </div>
  </div>
  <div
    class="c10 comment__content"
  >
    <div
      class="c11 button-group"
      data-role="button-group"
    >
      <button
        class="c12 button button--secondary"
        data-role="button"
        title=""
        type="button"
      >
        Show all
      </button>
    </div>
  </div>
</div>
`;

