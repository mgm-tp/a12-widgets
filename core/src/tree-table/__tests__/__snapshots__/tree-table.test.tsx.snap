exports[`com.mgmtp.a12.widgets.tree-table > rendering tree table with row styling 1`] = `
.c0 {
  border: 0px;
  clip: rect(0px, 0px, 0px, 0px);
  clip-path: inset(100%);
  height: 1px;
  min-height: 1px;
  overflow: hidden;
  padding: 0px;
  position: absolute;
  top: 0px;
  width: 1px;
  margin: -1px !important;
}

.c0 * {
  width: 1px;
  height: 1px;
}

<span
  class="c0 -u-unseenButRead"
  data-role="hidden-text"
  id="test-hidden-text"
>
  You can trigger the row action with Enter on a cell.
</span>
`;
