  box-shadow: rgba(22, 25, 29, 0.4) 1px 2px 2px 0px;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  max-height: 100%;
  outline: none;
  overflow-y: auto;
  padding: 4px 8px;
  overflow-wrap: break-word;
  word-break: break-word;
}

.c0 {
  max-width: 472px;
  margin: 9px 16px 0px;
  position: relative;
  outline: none;
}

.c0 + span {
  outline: none;
}

.c0::before {
  background-color: rgb(255, 255, 255);
  border-width: 1px medium medium 1px;
  border-style: solid none none solid;
  border-color: rgb(181, 76, 23) currentcolor currentcolor rgb(181, 76, 23);
  border-image: initial;
  content: "";
  height: 12px;
  pointer-events: none;
  position: absolute;
