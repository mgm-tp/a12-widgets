          >
            search
          </span>
        </i>
        <span
          class="c7 badge-wrapper"
          data-role="badge"
          id="info-badge-id"
          style="right: -8px;"
          title="9 Info notifications"
        >
          <span
            class="c4 -u-unseenButRead"
            data-role="hidden-text"
          >
            , 9 Info notifications
          </span>
          <span
            aria-hidden="true"
            class="c8 c9 badge badge--info"
            data-role="badge-content"
            data-type="info-badge"
          >
            9
