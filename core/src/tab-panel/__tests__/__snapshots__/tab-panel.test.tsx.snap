exports[`com.mgmtp.a12.widgets.tab-panel > render basic tab-panel 1`] = `
.c4 {
  border: 0px;
  clip: rect(0px, 0px, 0px, 0px);
  clip-path: inset(100%);
  height: 1px;
  min-height: 1px;
  overflow: hidden;
  padding: 0px;
  position: absolute;
  top: 0px;
  width: 1px;
  margin: -1px !important;
}

.c4 * {
  width: 1px;
  height: 1px;
}

.c6 {
  box-sizing: border-box;
  color: rgb(127, 140, 155);
  display: inline-block;
  direction: ltr;
  font-family: "Material Symbols Outlined";
  font-variation-settings: "FILL" 1, "wght" 400, "GRAD" 0, "opsz" 24;
  font-size: 1rem;
  font-style: normal;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 1;
  text-transform: none;
  white-space: nowrap;
  overflow-wrap: normal;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizelegibility;
  font-feature-settings: "liga";
}

.c6 > span {
  display: inline-block;
}

.c6.c6 {
  max-width: unset;
}

.c9 {
  align-items: center;
  border-radius: 8px;
  box-shadow: rgba(22, 25, 29, 0.4) 0px 1px 2px 0px;
  display: inline-flex;
  flex-shrink: 0;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  height: calc(18px);
  line-height: normal;
  outline: transparent solid 1px;
  padding: 0px 4px;
  transform: scale(1);
  transition: transform 0.25s ease-in-out;
  background-color: rgb(5, 104, 174);
  color: rgb(255, 255, 255);
}

.c7 {
  display: inline-flex;
  position: absolute;
  top: calc(-12.15px);
}

.c7.badge-wrapper-exit-active .c8 {
  transform: scale(0);
}

.c7.badge-wrapper-enter .c8 {
  transform: scale(0);
}

.c7.badge-wrapper-enter-active .c8 {
  transform: scale(1);
}

.c2 {
  align-items: center;
  box-sizing: border-box;
  color: rgb(255, 255, 255);
  display: flex;
  font-size: 1.125rem;
  justify-content: center;
  list-style: none;
  min-height: 48px;
  position: relative;
  padding: 8px;
  cursor: pointer;
}

.c2 .c5 {
  color: inherit;
  font-size: inherit;
}

.c2::before {
  border: 2px solid transparent;
  inset: 0px;
  content: "";
  position: absolute;
}

.c2:focus {
  background-color: rgba(0, 0, 0, 0.3);
  color: rgb(255, 255, 255);
  margin: 0px 1px;
  outline: rgb(255, 255, 255) dotted 1px;
}

.c2:focus::before {
  border-color: rgb(255, 255, 255);
}

.c10 {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  font-size: 1.125rem;
  justify-content: center;
  list-style: none;
  min-height: 48px;
  position: relative;
  padding: 8px;
  background: transparent;
  color: rgb(169, 179, 188);
}

.c10 .c5 {
  color: inherit;
  font-size: inherit;
}

.c10::before {
  border: 2px solid transparent;
  inset: 0px;
  content: "";
