  .c2:active::before {
    border-color: rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c2:hover {
    background-color: rgba(0, 0, 0, 0.3);
    color: rgb(255, 255, 255);
  }

  .c2:hover::before {
    border-color: rgb(255, 255, 255);
  }
}

<div
