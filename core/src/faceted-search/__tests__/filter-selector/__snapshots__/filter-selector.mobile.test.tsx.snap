}

.c1 .c6 {
  display: flex;
}

.c6 .c13.c13 {
  height: auto;
  position: relative;
}

.c6 .c9:not([data-role="filter-selector-content-secondary"]) {
  display: flex;
  flex-grow: 1;
  flex-shrink: 1;
  max-height: unset;
  max-width: unset;
  min-width: unset;
}

.c6 .c69 {
  align-items: center;
  display: flex;
}

.c6 .c67 {
  color: rgb(97, 111, 124);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c6 .c7.c7 {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  flex-shrink: 1;
  margin: 0px;
  min-height: 0px;
}

.c6 [data-role="filter-selector-content-primary"] {
  overflow: hidden;
}

.c6 [data-role="filter-selector-content-secondary"] {
  border-bottom: 1px solid rgb(226, 230, 233);
  flex-shrink: 0;
  overflow-y: auto;
  width: 100%;
}

.c6 [data-role="filter-selector-content-secondary"] .c42 {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
}

.c6 [data-role="filter-selector-content-secondary"] .c42::after {
  content: normal;
}

.c6 [data-role="filter-selector-content-secondary"] .c13::after {
  background-color: rgb(5, 104, 174);
  inset: 0px auto 0px 0px;
  content: "";
  position: absolute;
  width: 4px;
}

.c6 [data-role="filter-selector-content-secondary"] .c45 .c47,
.c6 [data-role="filter-selector-content-secondary"] .c45 .c47:focus {
  background-color: transparent;
  background-image: none;
}

.c6 [data-role="filter-selector-content-secondary"] .c45 .c47::after,
.c6 [data-role="filter-selector-content-secondary"] .c45 .c47:focus::after {
  background-color: transparent;
}

.c6 [data-role="filter-selector-content-secondary"] .c45 .c47:last-child::before {
  border-bottom-width: medium;
  border-bottom-style: none;
  border-bottom-color: currentcolor;
}

.c6 [data-role="filter-selector-content-secondary"] .c45 .c47 .c51 {
  padding: 0px 16px;
}

.c50 .c71 .c25 {
  transform: rotate(-180deg);
}

@media (pointer: coarse) {
