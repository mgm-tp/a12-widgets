  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
}

.c6 [data-role="filter-selector-content-secondary"] .c41::after {
  content: normal;
}

.c6 [data-role="filter-selector-content-secondary"] .c13::after {
  background-color: rgb(5, 104, 174);
  inset: 0px auto 0px 0px;
  content: "";
  position: absolute;
  width: 4px;
}

.c6 [data-role="filter-selector-content-secondary"] .c44 .c46,
.c6 [data-role="filter-selector-content-secondary"] .c44 .c46:focus {
  background-color: transparent;
  background-image: none;
}

.c6 [data-role="filter-selector-content-secondary"] .c44 .c46::after,
.c6 [data-role="filter-selector-content-secondary"] .c44 .c46:focus::after {
  background-color: transparent;
}

.c6 [data-role="filter-selector-content-secondary"] .c44 .c46:last-child::before {
  border-bottom-width: medium;
  border-bottom-style: none;
  border-bottom-color: currentcolor;
}

.c6 [data-role="filter-selector-content-secondary"] .c44 .c46 .c49 {
  padding: 0px 16px;
}

@media (pointer: coarse) {
  .c23:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: transparent;
    box-shadow: none;
