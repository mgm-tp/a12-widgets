  min-height: 0px;
  padding: 0px;
  width: 2rem;
  background: transparent;
  box-shadow: none;
  color: rgb(169, 179, 188);
  cursor: default;
}

.c17 .c8 {
  user-select: none;
}

.c17 .c8 {
  color: inherit;
}

.c17 .c8 {
  font-size: inherit;
}

.c17.c17 .c8 {
  color: inherit;
}

.h_inlineBlock.h_middleAlign .c17.c17 {
  display: block;
  height: auto;
  min-height: 0px;
}

.h_inlineBlock.h_middleAlign .c17.c17 > .c8 {
  display: block;
}

.c0 {
  height: 100%;
  isolation: isolate;
}

.c1 {
  height: 100%;
  list-style: none;
  padding-left: 0px;
  margin: 0px;
  overflow-y: auto;
  -webkit-tap-highlight-color: transparent;
}

.c3 {
  position: relative;
}

.c3 > .dnd-dropTarget {
  bottom: 0px;
  height: 8px;
  position: absolute;
  width: 100%;
}

.c3 > .dnd-dropTarget + .dnd-dropTarget {
  bottom: auto;
  top: 0px;
}

.c4 {
  min-height: 48px;
  min-width: 300px;
  outline: none;
  padding-left: calc(64px);
  position: relative;
}

.c4::before {
  border-bottom: 1px solid rgb(211, 214, 220);
  inset: 0px;
  content: "";
  display: block;
  position: absolute;
  pointer-events: none;
}

[data-role="table-body-cell"] > .c2 > .c4.c4 {
  padding-left: calc(40px);
}

.c4:focus {
  background-color: rgb(241, 242, 244);
  outline: none;
}

