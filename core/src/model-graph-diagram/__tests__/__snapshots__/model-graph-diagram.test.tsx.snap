// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`com.mgmtp.a12.widgets.model-graph-diagram > render Label with additional information 1`] = `
.c0 {
  align-items: center;
  border-radius: 10px;
  color: rgb(32, 46, 93);
  display: inline-flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  gap: 8px;
  justify-content: center;
  height: 20px;
  padding: 0px 8px;
  position: relative;
  background-color: rgb(235, 241, 247);
  cursor: pointer;
}

.c0::before {
  border: 2px solid transparent;
  border-radius: 10px;
  content: "";
  inset: 0px;
  position: absolute;
}

.c0:focus {
  box-shadow: rgba(32, 46, 93, 0.4) 0px 1px 2px 0px;
  outline: rgb(51, 51, 51) dotted 1px;
}

.c0:focus::before {
  border-color: rgb(213, 0, 117);
}

.c0:focus::after {
  border-left-color: rgb(213, 0, 117);
}

.c1 {
  font-style: italic;
}

@media (pointer: coarse) {
  .c0:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    box-shadow: rgba(32, 46, 93, 0.4) 0px 1px 2px 0px;
  }

  .c0:active::before {
    border-color: rgb(213, 0, 117);
  }

  .c0:active::after {
    border-left-color: rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c0:hover {
    box-shadow: rgba(32, 46, 93, 0.4) 0px 1px 2px 0px;
  }

  .c0:hover::before {
    border-color: rgb(213, 0, 117);
  }

  .c0:hover::after {
    border-left-color: rgb(213, 0, 117);
  }
}

<div
  class="c0"
  data-role="diagram-label"
  tabindex="0"
>
  <div>
    1
  </div>
  <div
    class="c1"
  >
    { duplicable, orderable }
  </div>
</div>
`;

