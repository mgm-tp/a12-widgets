exports[`com.mgmtp.a12.widgets.model-graph-diagram > render Node 1`] = `
.c0 {
  align-items: center;
  box-sizing: border-box;
  background-color: rgb(255, 255, 255);
  border: 2px solid rgb(0, 88, 159);
  display: flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  justify-content: center;
  height: 80px;
  line-height: 1.35;
  position: relative;
  padding: 8px;
  text-align: center;
  width: 160px;
  cursor: pointer;
  color: rgb(32, 46, 93);
}

.c0:focus {
  border-color: rgb(213, 0, 117);
  box-shadow: rgba(32, 46, 93, 0.4) 0px 1px 2px 0px;
  outline: rgb(51, 51, 51) dotted 1px;
}

@media (pointer: coarse) {
  .c0:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    border-color: rgb(213, 0, 117);
    box-shadow: rgba(32, 46, 93, 0.4) 0px 1px 2px 0px;
  }
}

@media (pointer: fine) {
  .c0:hover {
    border-color: rgb(213, 0, 117);
    box-shadow: rgba(32, 46, 93, 0.4) 0px 1px 2px 0px;
  }
}

<div
  class="c0"
  data-role="diagram-label"
  tabindex="0"
>
  Node
</div>
`;

exports[`com.mgmtp.a12.widgets.model-graph-diagram > render Port as corner point 1`] = `
.c0 {
  border-radius: 50%;
  box-shadow: rgb(255, 255, 255) 0px 0px 2px 0px inset;
  filter: blur(1px);
  height: 4px;
  width: 4px;
  background-color: rgb(7, 154, 233);
  cursor: pointer;
}

@media (pointer: coarse) {
  .c0:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(213, 0, 117);
    box-shadow: rgba(32, 46, 93, 0.4) 0px 1px 2px 0px;
    filter: blur(0px);
    padding: 0px;
  }
}

@media (pointer: fine) {
  .c0:hover {
    background-color: rgb(213, 0, 117);
    box-shadow: rgba(32, 46, 93, 0.4) 0px 1px 2px 0px;
    filter: blur(0px);
    padding: 0px;
  }
}

<div
  class="c0"
  data-role="diagram-port"
  tabindex="-1"
/>
`;

