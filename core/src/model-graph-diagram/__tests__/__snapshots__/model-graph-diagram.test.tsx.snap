exports[`com.mgmtp.a12.widgets.model-graph-diagram > render default Label 1`] = `
.c0 {
  align-items: center;
  border-radius: 13px;
  color: rgb(32, 46, 93);
  display: inline-flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  gap: 8px;
  justify-content: center;
  height: 26px;
  padding: 0px 8px;
  position: relative;
  background-color: rgb(235, 241, 247);
  cursor: pointer;
}

.c0::before {
  border: 2px solid transparent;
  border-radius: 13px;
  content: "";
  inset: 0px;
  position: absolute;
}

.c0:focus {
  box-shadow: rgba(32, 46, 93, 0.4) 0px 1px 2px 0px;
  outline: rgb(51, 51, 51) dotted 1px;
}

.c0:focus::before {
  border-color: rgb(213, 0, 117);
}

