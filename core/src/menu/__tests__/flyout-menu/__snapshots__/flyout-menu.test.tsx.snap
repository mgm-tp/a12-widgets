}

.c1 {
  max-width: 472px;
  margin: 9px 0px 0px;
  position: relative;
  outline: none;
}

.c1 + span {
  outline: none;
}

.c1::before {
  background-color: rgb(255, 255, 255);
  border-width: 1px medium medium 1px;
  border-style: solid none none solid;
  border-color: rgb(181, 76, 23) currentcolor currentcolor rgb(181, 76, 23);
  border-image: initial;
  content: "";
  height: 12px;
  pointer-events: none;
  position: absolute;
  width: 12px;
  top: -6px;
  transform: translateX(-50%) rotate(45deg);
  left: 6px;
}

<div
