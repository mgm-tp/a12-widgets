exports[`com.mgmtp.a12.widgets.icon-picker > render basic icon-picker with selected icon 1`] = `
.c23 {
  display: inline-block;
  font-size: 0px;
  vertical-align: middle;
  color: rgb(5, 104, 174);
}

.c11 {
  box-sizing: border-box;
  color: rgb(127, 140, 155);
  display: inline-block;
  direction: ltr;
  font-family: "Material Icons";
  font-size: 1rem;
  font-style: normal;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 1;
  text-transform: none;
  white-space: nowrap;
  overflow-wrap: normal;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizelegibility;
  font-feature-settings: "liga";
}

.c11 > span {
  display: inline-block;
}

.c11.c11 {
  max-width: unset;
}

.c22 .c11 {
  color: inherit;
}

.c22 .c28 {
  color: inherit;
}

.c18.c18.c18,
.c22 .c18.c18.c18 {
  font-size: 1.5rem;
}

.c24 {
  align-items: center;
  border: 2px solid transparent;
  cursor: pointer;
  display: inline-flex;
  justify-content: center;
  font-family: "Open Sans", sans-serif;
  font-weight: 700;
  gap: 4px;
  outline: none;
  position: relative;
  text-transform: uppercase;
  vertical-align: middle;
  border-radius: 50%;
  flex-shrink: 0;
  font-size: 1.125rem;
  height: 2rem;
  min-height: 0px;
  padding: 0px;
  width: 2rem;
  background: transparent;
  color: rgb(5, 104, 174);
}

.c24 .c10 {
  user-select: none;
}

.c24 .c10 {
  color: inherit;
}

.c24 .c10 {
  font-size: inherit;
}

.c24:not(:disabled):focus {
  outline: rgb(51, 51, 51) dotted 1px;
  background-color: transparent;
  box-shadow: none;
  color: rgb(213, 0, 117);
  border: 2px solid rgb(213, 0, 117);
}

.c22 .c24.c24 {
  font-size: 1.25rem;
  height: fit-content;
  min-height: 0px;
  padding: 0px;
  width: fit-content;
}

.c22 .c24.c24:not(:active):not(:hover):not(:focus) {
  color: inherit;
}

.c22 .c24.c24:not(:active):not(:hover):not(:focus) .c10:not(.StyledVariantIconWrapper-sc-bMgxYI) {
  color: inherit;
}

.c22 .c24.c24:focus .c10 {
  color: inherit;
}

.h_inlineBlock.h_middleAlign .c24.c24 {
  display: block;
  height: auto;
  min-height: 0px;
}

.h_inlineBlock.h_middleAlign .c24.c24 > .c10 {
  display: block;
}

.c16 {
  align-items: center;
  border: 2px solid transparent;
  cursor: pointer;
  display: inline-flex;
  justify-content: center;
  font-family: "Open Sans", sans-serif;
  font-weight: 700;
  gap: 4px;
