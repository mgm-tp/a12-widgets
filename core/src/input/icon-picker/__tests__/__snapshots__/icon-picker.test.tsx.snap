  padding: 4px;
}

@media (pointer: coarse) {
  .c21:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: transparent;
    box-shadow: none;
    color: rgb(213, 0, 117);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c21:not(:disabled):hover {
    background-color: transparent;
    box-shadow: none;
    color: rgb(213, 0, 117);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c21:hover {
    outline: transparent solid 1px;
  }
}

@media (pointer: coarse) {
  .c18 .c21.c21:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c18 .c21.c21:active .c12 {
    color: inherit;
  }
}

@media (pointer: fine) {
  .c18 .c21.c21:hover .c12 {
    color: inherit;
  }
}

@media (pointer: coarse) {
  .c18 .c36.c36:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c18 .c36.c36:active .c12 {
    color: inherit;
  }
}

@media (pointer: fine) {
  .c18 .c36.c36:hover .c12 {
    color: inherit;
  }
}

@media (pointer: coarse) {
  .c30:not([data-type="icon-selected"]):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c30:not([data-type="icon-selected"]):active::after {
    border: 2px solid rgb(213, 0, 117);
    content: "";
  }
}

@media (pointer: fine) {
  .c30:not([data-type="icon-selected"]):hover {
    cursor: pointer;
  }

  .c30:not([data-type="icon-selected"]):hover::after {
    border: 2px solid rgb(213, 0, 117);
    content: "";
  }
}

@media (pointer: coarse) {
  .c30:not([data-type="icon-selected"]):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    color: rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c30:not([data-type="icon-selected"]):hover {
    color: rgb(213, 0, 117);
  }
}

@media (pointer: coarse) {
  .c30[data-type="multiselect-item"]:not(:last-child):not(:focus):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c30[data-type="multiselect-item"]:not(:last-child):not(:focus):active::after {
    border-bottom: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c30[data-type="multiselect-item"]:not(:last-child):not(:focus):hover::after {
    border-bottom: 2px solid rgb(213, 0, 117);
  }
}

