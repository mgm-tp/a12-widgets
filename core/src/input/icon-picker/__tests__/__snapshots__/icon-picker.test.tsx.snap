  overflow-y: auto;
  flex-flow: wrap;
}

.c36 {
  overflow-wrap: break-word;
  word-break: break-word;
  font-size: 0.625rem;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 36px;
}

.c37 {
  box-sizing: border-box;
  color: rgb(77, 77, 77);
  flex-shrink: 0;
  font-size: 0.75rem;
  line-height: 1rem;
  min-height: 24px;
  outline: none;
  position: relative;
  align-items: center;
  display: flex;
  flex-direction: column;
  padding: 8px 4px;
}

.c37::after {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  inset: 0px;
  display: block;
  pointer-events: none;
  position: absolute;
}

.c37:focus::after {
  border: 1px dotted rgb(22, 25, 29);
  content: "";
}

.c37[data-type="multiselect-item"]:has([data-role="checkbox-input-indeterminate"]):first-child {
  font-weight: 700;
}

.c37[data-type="multiselect-item"]:not(:last-child):not(:focus)::after {
  content: "";
}

.c37[data-type="multiselect-item"]:not(:last-child):not(:focus):has([data-role="checkbox-input-indeterminate"]):not(:active):not(:hover):first-child::after {
  border-bottom: 1px solid rgb(169, 179, 188);
}

.c33 {
  box-sizing: border-box;
  flex-shrink: 0;
  font-size: 0.75rem;
  line-height: 1rem;
  min-height: 24px;
  outline: none;
  position: relative;
  align-items: center;
  display: flex;
  flex-direction: column;
  padding: 8px 4px;
  color: rgb(77, 77, 77);
  background-color: transparent;
}

.c33::after {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  inset: 0px;
  display: block;
  pointer-events: none;
  position: absolute;
}

.c33 .c10 {
  color: inherit;
}

.c33:focus::after {
  border: 1px dotted rgb(22, 25, 29);
  content: "";
}

.c33[data-type="multiselect-item"]:has([data-role="checkbox-input-indeterminate"]):first-child {
  font-weight: 700;
}

.c33[data-type="multiselect-item"]:not(:last-child):not(:focus)::after {
  content: "";
}

.c33[data-type="multiselect-item"]:not(:last-child):not(:focus):has([data-role="checkbox-input-indeterminate"]):not(:active):not(:hover):first-child::after {
  border-bottom: 1px solid rgb(169, 179, 188);
}

.c38 {
  align-items: center;
  display: flex;
  height: 24px;
  width: 24px;
  justify-content: center;
  margin: 0px;
}

.c38 .c10 {
  color: inherit;
}

.c35 {
  align-items: center;
  display: flex;
  height: 24px;
  width: 24px;
  justify-content: center;
  margin: 0px;
  background-color: rgb(5, 104, 174);
  border-radius: 50%;
  color: rgb(255, 255, 255);
}

.c35 .c10 {
  color: inherit;
}

.c0 {
  width: 100%;
}

.c30 {
  margin: 4px 0px 0px;
}

.c30 .c32[aria-selected="true"] {
  color: rgb(77, 77, 77);
}

.c30 .c32[aria-selected="true"] .c34 {
  background-color: rgb(5, 104, 174);
  border-radius: 50%;
  color: rgb(255, 255, 255);
}

@media (pointer: coarse) {
  .c24:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: transparent;
    box-shadow: none;
    color: rgb(213, 0, 117);
    border: 2px solid rgb(213, 0, 117);
  }
}

