  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
}

.c7 {
  height: 20px;
}

.c7 + label {
  height: 20px;
}

.c7 + label > span {
  border-radius: 50%;
  background-color: rgb(255, 255, 255);
}

.c7 + label > span::before {
  border-radius: inherit;
  box-sizing: border-box;
}

.c7:focus + label > span::before {
  border: 2px solid rgb(213, 0, 117);
}

.c7:focus + label > span::before {
  outline: rgb(51, 51, 51) dotted 1px;
