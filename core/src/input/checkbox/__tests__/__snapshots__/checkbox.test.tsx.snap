  border: 1px solid rgb(169, 179, 188);
}

.c6 > button {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  height: 100%;
  padding: 0px;
  width: 100%;
}

.c6 + label > span::after {
  background-color: rgb(77, 77, 77);
  content: " ";
  height: 6px;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 6px;
  border: 3px solid transparent;
}

.c6 + label > span::after {
  background-color: rgb(169, 179, 188);
}

<div
  class="c0 c1 field"
  data-role="checkbox"
>
  <div
    class="c2 field__control field__control--boolean"
    data-role="checkbox-control"
    id="testId-controls"
  >
    <span
      class="c3"
      data-role="checkbox-control-inner"
    >
      <span
        class="c4 c5 c6 field__check field__check--readonly field__check--indeterminate"
        data-role="checkbox-input-indeterminate"
      >
        <button
          aria-checked="mixed"
          data-role="checkbox-input"
          disabled=""
          id="testId"
          role="checkbox"
        />
      </span>
      <label
        aria-hidden="true"
        data-role="checkbox-control-inner-hidden-label"
        for="testId"
      >
        <span />
      </label>
    </span>
    <label
      class="c7 c8 label field__label field__label field__label--readonly"
      data-role="checkbox-label"
      for="testId"
    >
      Test checkbox
    </label>
  </div>
</div>
`;
