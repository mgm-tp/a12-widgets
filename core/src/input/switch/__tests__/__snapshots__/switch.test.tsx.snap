        >
          <i
            class="c3 c4 plasma-icon"
            data-role="plasma-icon"
          >
            <span
              aria-hidden="true"
            >
              remove
            </span>
          </i>
        </span>
      </span>
      <input
        aria-describedby="test-id-warning"
        class="c16 switch__input"
        data-role="switch-input"
        id="test-id"
        type="checkbox"
      />
    </span>
  </div>
</div>
`;
