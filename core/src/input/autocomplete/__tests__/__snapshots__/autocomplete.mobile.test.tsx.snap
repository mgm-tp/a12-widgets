  .c32 .c26.c26:active .c11 {
    color: inherit;
  }
}

@media (pointer: fine) {
  .c32 .c26.c26:hover .c11 {
    color: inherit;
  }
}

@media (pointer: coarse) {
  .c48.c48:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c48.c48:not(:disabled):hover {
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media only screen and (max-width: 756px) {
  .c40 {
    width: 100%;
  }
}

@media (pointer: coarse) {
  .c21:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: fine) {
  .c21:hover {
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: coarse) {
  .c21.c21:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    box-shadow: rgb(201, 29, 29) 0px 1px 0px 0px;
  }
}

@media (pointer: fine) {
  .c21.c21:hover {
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: coarse) {
  .c54.c54:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    box-shadow: rgb(201, 29, 29) 0px 1px 0px 0px;
  }
}

@media (pointer: fine) {
  .c54.c54:hover {
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: coarse) {
  .c60:not([data-type="icon-selected"]):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c60:not([data-type="icon-selected"]):active::after {
    border: 2px solid rgb(213, 0, 117);
    content: "";
  }
}

@media (pointer: fine) {
  .c60:not([data-type="icon-selected"]):hover {
    cursor: pointer;
  }

  .c60:not([data-type="icon-selected"]):hover::after {
    border: 2px solid rgb(213, 0, 117);
    content: "";
  }
}

@media (pointer: coarse) {
  .c60[data-type="multiselect-item"]:not(:last-child):not(:focus):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c60[data-type="multiselect-item"]:not(:last-child):not(:focus):active::after {
    border-bottom: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c60[data-type="multiselect-item"]:not(:last-child):not(:focus):hover::after {
    border-bottom: 2px solid rgb(213, 0, 117);
  }
}

