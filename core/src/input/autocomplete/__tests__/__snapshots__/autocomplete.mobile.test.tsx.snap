exports[`com.mgmtp.a12.widgets.autocomplete.mobile > render readonly mobile autocomplete 1`] = `
.c8 {
  border: 0px;
  clip: rect(0px, 0px, 0px, 0px);
  clip-path: inset(100%);
  height: 1px;
  min-height: 1px;
  overflow: hidden;
  padding: 0px;
  position: absolute;
  top: 0px;
  width: 1px;
  margin: -1px !important;
}

.c8 * {
  width: 1px;
  height: 1px;
}

.c30 {
  display: inline-block;
  font-size: 0px;
  vertical-align: middle;
  color: rgb(5, 104, 174);
}

.c13 {
  box-sizing: border-box;
  color: rgb(127, 140, 155);
  display: inline-block;
  direction: ltr;
  font-family: custom-icons;
  font-size: 1rem;
  font-style: normal;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 1;
  text-transform: none;
  white-space: nowrap;
  overflow-wrap: normal;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizelegibility;
  font-feature-settings: "liga";
}

.c13 > span {
  display: inline-block;
}

.c13.c13 {
  max-width: unset;
}

.c29 .c13 {
  color: inherit;
}

.c17 {
  box-sizing: border-box;
  color: rgb(127, 140, 155);
  display: inline-block;
  direction: ltr;
  font-family: "Material Icons";
  font-size: 1rem;
  font-style: normal;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 1;
  text-transform: none;
  white-space: nowrap;
  overflow-wrap: normal;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizelegibility;
  font-feature-settings: "liga";
}

.c17 > span {
  display: inline-block;
}

.c17.c17 {
  max-width: unset;
}

.c29 .c17 {
  color: inherit;
}

.c36.c36.c36,
.c29 .c36.c36.c36 {
  font-size: 1.5rem;
}

.c14.c14 {
  color: rgb(201, 29, 29);
}

.c18.c18 {
  color: rgb(175, 121, 2);
}

.c20.c20 {
  color: rgb(5, 104, 174);
}

.c26 {
  align-items: center;
  border: 2px solid transparent;
  cursor: pointer;
  display: inline-flex;
  justify-content: center;
  font-family: "Open Sans", sans-serif;
  font-weight: 700;
  gap: 4px;
  outline: none;
  position: relative;
  text-transform: uppercase;
  vertical-align: middle;
  border-radius: 50%;
  flex-shrink: 0;
  font-size: 1.125rem;
  height: 2rem;
  min-height: 0px;
  padding: 0px;
  width: 2rem;
  background: transparent;
  color: rgb(5, 104, 174);
}

.c26 .c11 {
  user-select: none;
}

.c26 .c11 {
  color: inherit;
}

.c26 .c11 {
  font-size: inherit;
}

.c26:not(:disabled):focus {
  outline: rgb(51, 51, 51) dotted 1px;
  background-color: transparent;
  box-shadow: none;
  color: rgb(213, 0, 117);
  border: 2px solid rgb(213, 0, 117);
}

.c29 .c26.c26 {
  font-size: 1.25rem;
  height: fit-content;
  min-height: 0px;
  padding: 0px;
  width: fit-content;
}

.c29 .c26.c26:not(:active):not(:hover):not(:focus) {
  color: inherit;
}

.c29 .c26.c26:not(:active):not(:hover):not(:focus) .c11:not(.c12) {
  color: inherit;
}

.c29 .c26.c26:focus .c11 {
  color: inherit;
}

.h_inlineBlock.h_middleAlign .c26.c26 {
  display: block;
  height: auto;
  min-height: 0px;
}

.h_inlineBlock.h_middleAlign .c26.c26 > .c11 {
  display: block;
}

.c7 {
  color: rgb(77, 77, 77);
  display: inline-block;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  line-height: 1.45;
  text-transform: none;
  margin: 0px 0px 4px;
  align-self: center;
}

.c7:empty {
  display: none;
}

.c9 {
  display: flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  margin: 0px 0px 4px;
  padding: 4px 8px;
  background: rgb(252, 233, 233);
  color: rgb(201, 29, 29);
}

.c16 {
  display: flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
