  width: 14px;
  z-index: 1;
  cursor: pointer;
}

.c8 + label {
  align-items: center;
  cursor: pointer;
  display: inline-flex;
  position: relative;
  text-align: left;
  vertical-align: top;
}

.c8 + label > span {
  display: inline-block;
  height: 14px;
  margin-top: 0px;
  position: relative;
