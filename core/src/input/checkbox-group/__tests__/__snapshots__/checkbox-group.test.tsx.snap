  border: 2px solid rgb(213, 0, 117);
}

.c1 .c4 {
  margin: 0px 0px 2px;
  min-height: 0px;
  padding: 0px;
}

@media (pointer: coarse) {
  .c8:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c8:active + label > span::before {
    inset: -1px;
  }
}

@media (pointer: fine) {
  .c8:hover + label > span::before {
    inset: -1px;
  }
}

@media (pointer: coarse) {
  .c9:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c9:active + label > span::before {
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c9:hover + label > span::before {
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c9 + label:hover > span::after {
    background-color: rgb(213, 0, 117);
  }

  .c9 + label:hover > span::before {
    border: 2px solid rgb(213, 0, 117);
  }
}

<div
  class="c0 c1 field field--block"
  data-role="checkbox-group"
  id="test checkbox-group"
>
  <label
    class="c2 c3 label field__label"
    data-role="checkbox-group-label"
    id="test checkbox-group-label"
  >
    Checkbox Group
  </label>
  <div
    class="field__group"
  >
    <div
      class="c4 c0 c5 field field--block"
      data-role="checkbox"
    >
      <div
        class="c6 field__control field__control--boolean"
        data-role="checkbox-control"
        id="item-1-controls"
      >
        <span
          class="c7"
          data-role="checkbox-control-inner"
        >
          <input
            aria-checked="false"
            aria-describedby="test checkbox-group-label"
            class="c8 c9 field__check field__check--warning"
            data-role="checkbox-input"
            id="item-1"
            type="checkbox"
          />
          <label
            aria-hidden="true"
            data-role="checkbox-control-inner-hidden-label"
            for="item-1"
          >
            <span />
          </label>
        </span>
        <label
          class="c2 c3 label field__label field__label"
          data-role="checkbox-label"
          for="item-1"
        >
          Option 1
        </label>
      </div>
    </div>
    <div
      class="c4 c0 c5 field field--block"
      data-role="checkbox"
    >
      <div
        class="c6 field__control field__control--boolean"
        data-role="checkbox-control"
        id="item-2-controls"
      >
        <span
          class="c7"
          data-role="checkbox-control-inner"
        >
          <input
            aria-checked="false"
            aria-describedby="test checkbox-group-label"
            class="c8 c9 field__check field__check--warning"
            data-role="checkbox-input"
            id="item-2"
            type="checkbox"
          />
          <label
            aria-hidden="true"
            data-role="checkbox-control-inner-hidden-label"
            for="item-2"
          >
            <span />
          </label>
        </span>
        <label
          class="c2 c3 label field__label field__label"
          data-role="checkbox-label"
          for="item-2"
        >
          Option 2
        </label>
      </div>
    </div>
    <div
      class="c4 c0 c5 field field--block"
      data-role="checkbox"
    >
      <div
        class="c6 field__control field__control--boolean"
        data-role="checkbox-control"
        id="item-3-controls"
      >
        <span
          class="c7"
          data-role="checkbox-control-inner"
        >
          <input
            aria-checked="false"
            aria-describedby="test checkbox-group-label"
            class="c8 c9 field__check field__check--warning"
            data-role="checkbox-input"
            id="item-3"
            type="checkbox"
          />
          <label
            aria-hidden="true"
            data-role="checkbox-control-inner-hidden-label"
            for="item-3"
          >
            <span />
          </label>
        </span>
        <label
          class="c2 c3 label field__label field__label"
          data-role="checkbox-label"
          for="item-3"
        >
          Option 3
        </label>
      </div>
    </div>
  </div>
</div>
`;
