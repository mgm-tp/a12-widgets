exports[`com.mgmtp.a12.widgets.input.custom.select > desktop > render select with tooltip 1`] = `
.c1 {
  box-sizing: border-box;
  flex-grow: 1;
  width: 100%;
}

.c4 {
  appearance: none;
  background-color: inherit;
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  border-radius: 0px;
  caret-color: transparent;
  color: inherit;
  font-size: inherit;
  flex-grow: 1;
  font-style: inherit;
  font-weight: inherit;
  font-family: inherit;
  height: 100%;
  padding: 0px 32px 0px 12px;
  text-align: inherit;
  text-transform: inherit;
  width: 100%;
  cursor: pointer;
}

.c4.c4.c4 {
  outline: transparent solid 1px;
}

.c4::selection {
  background-color: transparent;
}

.c4::placeholder {
  font-style: italic;
  color: rgb(89, 102, 115);
  opacity: 1;
}

.c0[class*="h_"] .c6.c6 {
  background-color: inherit !important;
}

.c2 {
  background-color: transparent;
  box-shadow: none;
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  border-radius: 0px;
  color: rgb(77, 77, 77);
  display: flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  height: 32px;
}

.c2:focus {
  outline: none;
}

.c3 {
  background-color: rgb(241, 242, 244);
  border-radius: inherit;
  box-shadow: rgb(89, 102, 115) 0px 1px 0px 0px;
  display: flex;
  flex-grow: 1;
  position: relative;
}

.c3:focus-within {
  box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  outline-offset: 0px;
  outline: rgb(51, 51, 51) dotted 1px;
}

.c5::after {
  align-items: center;
  color: rgb(127, 140, 155);
  content: "";
  display: flex;
  font-family: "Material Icons";
  font-size: 1.5rem;
  font-style: normal;
  justify-content: center;
  height: 100%;
  line-height: 0;
  pointer-events: none;
  position: absolute;
  right: 0px;
  text-transform: none;
  top: 50%;
  transform: translateY(-50%);
  width: 32px;
  overflow-wrap: normal;
}

@media (pointer: coarse) {
  .c3:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: fine) {
  .c3:hover {
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

<div
  class="c0 c1 field field--tooltips field--tooltips-1 field--block"
  data-role="select"
>
  <div
    class="c2 field__select"
    data-role="select-control"
  >
    <div
      class="c3 field__select-wrapper"
      data-role="select-wrapper"
    >
      <input
        aria-autocomplete="list"
        aria-expanded="false"
        aria-haspopup="listbox"
        class="c4 field__selectTitle"
        data-role="select-input"
        role="combobox"
        value=""
      />
      <span
        aria-hidden="true"
        class="c5 field__select-arrow"
      />
    </div>
    <div
      class="test-tooltip"
    >
      Test tooltip
    </div>
  </div>
</div>
`;

