                          </label>
                          <div
                            class="c43 c44 field__select"
                            data-role="month-selector-control"
                          >
                            <div
                              class="c45 c46 field__select-wrapper"
                              data-role="month-selector-wrapper"
                            >
                              <select
                                class="c47 c48 field__selectTitle"
                                data-role="month-selector-input"
                              >
                                <option
                                  class="c49 c50 field__selectOption"
                                  data-role="month-selector-option"
                                  value="0"
                                >
                                  January
                                </option>
                                <option
                                  class="c49 c50 field__selectOption"
                                  data-role="month-selector-option"
                                  value="1"
                                >
                                  February
                                </option>
                                <option
                                  class="c49 c50 field__selectOption"
                                  data-role="month-selector-option"
                                  value="2"
                                >
