<div>
  <div
    class="c0 field-wrapper field-wrapper--block "
    data-role="textline"
  >
    <div
      class="c1 c2 field__main"
    >
      <div
        class="c3 c4 field"
        data-role="textline-control"
      >
        <label
          class="c5 c6 label field__label"
          data-role="textline-label"
          for="test-id-input"
          id="test-id-input-label"
        >
          inputLabel
          <span
            class="c7 -u-unseenButRead"
            data-role="hidden-text"
          >
            , MM/DD/YYYY h:mm A
          </span>
        </label>
        <div
          class="c8 c9 message message--error field__message"
          data-role="textline-error-message"
          id="test-id-input-error"
        >
          <div
            class="c10 messageIcon"
          >
            <i
              class="c11 c12 c13 plasma-icon plasma-icon--error plasma-icon--custom"
              data-role="plasma-icon"
              title="Error"
            >
              <span
                aria-hidden="true"
              >
                
              </span>
              <span
                class="c14 -u-unseenButRead"
                data-role="hidden-text"
              >
                Error
              </span>
            </i>
          </div>
          <div
            class="c15 messageText"
            data-role="error-text"
          >
            inputErrorMessage
          </div>
        </div>
        <div
          class="c8 c16 message message--warning field__message"
          data-role="textline-warning-message"
          id="test-id-input-warning"
        >
          <div
            class="c10 messageIcon"
          >
            <i
              class="c11 c17 c18 plasma-icon plasma-icon--warning"
              data-role="plasma-icon"
              title="Warning"
            >
              <span
                aria-hidden="true"
              >
                warning
              </span>
              <span
                class="c14 -u-unseenButRead"
                data-role="hidden-text"
              >
                Warning
              </span>
            </i>
          </div>
          <div
            class="c15 messageText"
            data-role="warning-text"
          >
            inputWarningMessage
          </div>
        </div>
        <div
          class="c19 field__input field__input--warning field__input--error"
          data-role="textline-input-wrapper"
        >
          <div
            class="c20 c21 field__prefix field__prefix--last"
            data-role="textline-prefix-0"
          >
            <button
              aria-label="Select a date and time"
              aria-labelledby="test-id-input-label test-id-trigger-button-title"
              class="c22 c23 button button--icon button--block"
              data-role="button"
              data-type="icon"
              id="test-id-trigger-button"
              title="Select a date and time"
              type="button"
            >
              <i
                class="c11 c17 plasma-icon"
                data-role="plasma-icon"
              >
                <span
                  aria-hidden="true"
                >
                  event
                </span>
              </i>
              <span
                class="c14 -u-unseenButRead"
                data-role="hidden-text"
                id="test-id-trigger-button-title"
              >
                , Select a date and time
              </span>
            </button>
          </div>
          <span
            class="c24 supported-unseen-span"
          />
          <input
            aria-describedby="test-id-input-warning test-id-input-error test-id-input-label"
            class="c25 field__text"
            data-role="textline-input"
            id="test-id-input"
            placeholder="MM/DD/YYYY h:mm A"
            type="text"
            value="03/02/2022 12:00 AM"
          />
          <span
            class="c24 supported-unseen-span"
          />
        </div>
      </div>
      <div
        class="c26 c27 field-addon field-addon--after"
        data-role="textline--addon-after-0"
      >
        inputTooltips
      </div>
    </div>
    <div
      class="c28 field__helper"
    >
      <label
        class="c29 field__helper-text"
        data-role="textline-helper-text"
        for="test-id-input"
      >
        helperText
      </label>
      <div
        class="c26 c27 field-addon field-addon--after"
      >
        inputTooltips
      </div>
    </div>
  </div>
  <div
    class="c30"
    data-role="portal-placeholder"
  >
    <div
      class="portal base"
      data-role="portal"
    >
      <div>
        <div
          class="c31 attached-portal h_bottomStart"
          data-role="attached-portal"
          style="top: 117px; left: 0px; visibility: visible; opacity: 1;"
          tabindex="-1"
        >
          <div
            class="c32 DateTimePicker test-class"
