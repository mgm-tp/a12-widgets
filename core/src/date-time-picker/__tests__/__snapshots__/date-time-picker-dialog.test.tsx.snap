    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c8.c8:not(:disabled):hover {
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c39:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    border: 2px solid rgb(213, 0, 117);
    background-color: rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c39:hover {
    border: 2px solid rgb(213, 0, 117);
    background-color: rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c40:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 255, 255);
    border: 2px solid rgb(213, 0, 117);
    color: rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c40:hover {
    background-color: rgb(255, 255, 255);
    border: 2px solid rgb(213, 0, 117);
    color: rgb(213, 0, 117);
  }
}

@media (pointer: coarse) {
  .c13 .c23:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    border: 2px solid rgb(5, 104, 174);
  }
}

@media (pointer: fine) {
  .c13 .c23:hover {
    background-color: rgba(0, 0, 0, 0.2);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c13 .c25:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(213, 0, 117);
    color: rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c13 .c25:hover {
    background-color: rgb(213, 0, 117);
    color: rgb(255, 255, 255);
  }
}

