.c3 .c13 {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
}

.c39 {
  display: flex;
  flex: 1 0 0px;
  padding: 8px 0px;
}

.c40 {
  display: inline-flex;
  flex: 2 0 0px;
  justify-content: flex-end;
}

.c40 > .c9 {
  padding-bottom: 0px;
}

.c40 > .c6 {
  height: auto;
  max-width: 160px;
  text-align: right;
}

@media (pointer: coarse) {
