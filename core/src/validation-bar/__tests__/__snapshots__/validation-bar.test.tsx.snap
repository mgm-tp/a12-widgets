@media (pointer: coarse) {
  .c10:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: transparent;
    box-shadow: none;
    color: rgb(213, 0, 117);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c10:not(:disabled):hover {
    background-color: transparent;
    box-shadow: none;
    color: rgb(213, 0, 117);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c10:hover {
    outline: transparent solid 1px;
  }
}

@media (pointer: coarse) {
  .c16.c16:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    border: 2px solid rgb(255, 255, 255);
    color: rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c16.c16:hover {
    background-color: rgba(0, 0, 0, 0.2);
    border: 2px solid rgb(255, 255, 255);
    color: rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c21 .c9:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    border-color: rgb(22, 25, 29);
    color: rgb(22, 25, 29);
  }
}

@media (pointer: fine) {
  .c21 .c9:not(:disabled):hover {
    border-color: rgb(22, 25, 29);
    color: rgb(22, 25, 29);
  }
}

@media (pointer: coarse) {
  .c21 .c9[data-variant-type="primary"]:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
  }
}

@media (pointer: fine) {
  .c21 .c9[data-variant-type="primary"]:hover {
    background-color: rgba(0, 0, 0, 0.2);
  }
}

<section
  aria-label="Status of validation"
  class="c0 validation-bar validation-bar--error"
  data-role="validation-bar"
  tabindex="-1"
>
  <div
    class="c1 validation-bar__header"
    data-role="validation-bar-header"
  >
    <div
      class="c2 validation-bar__graphic"
      data-role="validation-bar-graphic"
    >
      <i
        class="c3 c4 plasma-icon plasma-icon--custom"
        data-role="plasma-icon"
      >
        <span
          aria-hidden="true"
        >
          
        </span>
      </i>
    </div>
    <div
      class="c5 c6 quick-access-button quick-access-button--secondary"
      data-role="quick-access-button"
    >
      <div
        class="c7 quick-access-button__divider"
        data-role="quick-access-button-divider"
      />
      <div
        class="c8 popup quick-access-button__popup"
        data-role="quick-access-button-popup"
      >
        <button
          aria-expanded="false"
          aria-haspopup="true"
          aria-label="Open validation menu"
          class="c9 c10 button button--icon c11"
          data-role="quick-access-button-trigger-element"
          data-type="icon"
          tabindex="0"
          title="Open validation menu"
          type="button"
        >
          <i
            class="c3 c12 plasma-icon"
            data-role="plasma-icon"
          >
            <span
              aria-hidden="true"
            >
              arrow_drop_down
            </span>
          </i>
        </button>
      </div>
    </div>
    <div
      class="c13 c14 simple-pagination"
      data-role="simple-pagination"
      role="navigation"
    >
      <button
        aria-disabled="false"
        aria-label="Previous issue"
        class="c9 c10 button button--icon c15 c16 simple-pagination__action"
        data-role="button"
        data-type="icon"
        tabindex="0"
        title="Previous issue"
        type="button"
      >
        <i
          class="c3 c12 plasma-icon simple-pagination__icon"
          data-role="plasma-icon"
        >
          <span
            aria-hidden="true"
          >
            arrow_left
          </span>
        </i>
      </button>
      <div
        class="c17 c18 simple-pagination__label"
        data-role="simple-pagination-label"
      >
        3 / 10
      </div>
      <button
        aria-disabled="false"
        aria-label="Next issue"
        class="c9 c10 button button--icon c15 c16 simple-pagination__action"
        data-role="button"
        data-type="icon"
        tabindex="0"
        title="Next issue"
        type="button"
      >
        <i
          class="c3 c12 plasma-icon simple-pagination__icon"
          data-role="plasma-icon"
        >
          <span
            aria-hidden="true"
          >
            arrow_right
          </span>
        </i>
      </button>
    </div>
  </div>
</section>
`;

