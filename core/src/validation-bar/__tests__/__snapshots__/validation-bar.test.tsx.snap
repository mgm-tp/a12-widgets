  max-width: unset;
}

.c0 {
  background-color: rgb(201, 29, 29);
  color: rgb(201, 29, 29);
  display: flex;
  flex-direction: column;
  padding: 0px;
}

.c0:focus {
  outline: none;
}

.c1 {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  padding: 2px 24px;
  min-height: 48px;
}

.c2 {
  display: flex;
  justify-content: center;
  margin: 0px 8px 0px 0px;
  padding: 0px;
}

.c2 .c3 {
  color: rgb(255, 255, 255);
  font-size: 1.25rem;
}

.c6 .c3 {
  color: rgb(22, 25, 29);
  font-size: 1.25rem;
}

.c5 {
  align-items: flex-start;
  background-color: rgb(255, 255, 255);
  border-radius: 3px;
  color: rgb(77, 77, 77);
  font-size: 0.75rem;
  font-weight: 400;
  margin: 0px 2px 2px;
  height: 180px;
  overflow-y: auto;
  outline: none;
  padding: 24px 24px 0px;
}

.c5::after {
  content: "";
  display: block;
  height: 8px;
  width: 100%;
}

<section
  aria-label="Status of validation"
  class="c0 validation-bar validation-bar--error"
  data-role="validation-bar"
  tabindex="-1"
>
  <div
    class="c1 validation-bar__header"
    data-role="validation-bar-header"
  >
    <div
      class="c2 validation-bar__graphic"
      data-role="validation-bar-graphic"
    >
      <i
        class="c3 c4 plasma-icon plasma-icon--custom"
        data-role="plasma-icon"
      >
        <span
          aria-hidden="true"
        >
          
        </span>
      </i>
    </div>
  </div>
  <div
    class="c5 validation-bar__content"
    data-role="validation-bar-content"
    tabindex="-1"
  >
    Content
  </div>
</section>
`;
