  flex-direction: column;
  max-width: 100%;
  padding: 0px 16px 8px calc(56px);
}

.c8 > * {
  align-self: flex-start;
  max-width: 100%;
}

.c2 {
  align-items: center;
  display: inline-flex;
  flex-direction: row;
  outline: none;
}

.c4 {
  align-content: center;
  display: flex;
  margin-right: 16px;
}

.c5 {
  line-height: 16px;
  overflow-wrap: break-word;
  word-break: break-word;
  max-width: 400px;
}

.c6 {
  margin-left: 16px;
}

@media (pointer: coarse) {
  .c7:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c7:not(:disabled):hover {
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c7:hover {
    outline: transparent solid 1px;
  }
}

@media screen and (max-width: 768px) {
  .c1 {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media screen and (max-width: 768px) {
  .c8 {
    border-top: 2px solid rgb(226, 230, 233);
    align-items: flex-start;
  }
}

@media screen and (max-width: 768px) {
  .c6 {
    margin-left: 40px;
  }
}

