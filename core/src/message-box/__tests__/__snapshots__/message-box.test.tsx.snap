  top: 0px;
  width: 1px;
  margin: -1px !important;
}

.c3 * {
  width: 1px;
  height: 1px;
}

.c6 {
  box-sizing: border-box;
  color: rgb(127, 140, 155);
  display: inline-block;
  direction: ltr;
  font-family: custom-icons;
  font-variation-settings: normal;
  font-size: 1rem;
  font-style: normal;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 1;
  text-transform: none;
  white-space: nowrap;
  overflow-wrap: normal;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizelegibility;
  font-feature-settings: "liga";
}

.c6 > span {
  display: inline-block;
}

.c6.c6 {
  max-width: unset;
}

.c7.c7 {
  color: rgb(201, 29, 29);
}

.c0 {
  position: relative;
  display: flex;
  flex-direction: column;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  border-radius: 4px;
  border: 2px solid rgb(201, 29, 29);
  background-color: rgb(255, 255, 255);
  color: rgb(77, 77, 77);
}

.c1 {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8px 16px;
}

.c9 {
  align-self: flex-start;
  display: flex;
  flex-direction: column;
  max-width: 100%;
  padding: 0px 16px 8px calc(56px);
}

.c9 > * {
  align-self: flex-start;
  max-width: 100%;
}

.c2 {
  align-items: center;
  display: inline-flex;
  flex-direction: row;
  outline: none;
}

.c4 {
  align-content: center;
  display: flex;
  margin-right: 16px;
}

.c4 .c5 {
  font-size: 1.5rem;
}

.c8 {
  line-height: 16px;
  overflow-wrap: break-word;
  word-break: break-word;
}

@media screen and (max-width: 768px) {
  .c1 {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media screen and (max-width: 768px) {
  .c9 {
    border-top: 2px solid rgb(226, 230, 233);
    align-items: flex-start;
  }
}

<div
  class="c0 messageBox messageBox--error"
  data-role="messagebox"
>
  <div
    class="c1 messageBox__mainContainer"
    data-role="messagebox-main"
  >
    <div
      class="c2 messageBox__title"
      data-role="messagebox-title"
      tabindex="-1"
    >
      <span
        class="c3 -u-unseenButRead"
        data-role="hidden-text"
      >
        Error
      </span>
      <div
        class="c4 messageBox__icon"
        data-role="messagebox-icon"
      >
        <i
          class="c5 c6 c7 plasma-icon plasma-icon--error plasma-icon--custom"
          data-role="plasma-icon"
        >
          <span
            aria-hidden="true"
          >
            
          </span>
        </i>
      </div>
      <div
        class="c8 messageBox__label"
        data-role="messagebox-label"
      >
        The specified attribute is not between the expected value of 0 and 100.
      </div>
    </div>
  </div>
  <div
    class="c9 messageBox__subContainer"
    data-role="messagebox-detail"
  >
    Test error message line
  </div>
</div>
`;

