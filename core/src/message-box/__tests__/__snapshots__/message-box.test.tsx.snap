  box-shadow: none;
  color: rgb(213, 0, 117);
  text-decoration: none;
  border: 2px solid rgb(213, 0, 117);
}

.h_inlineBlock.h_middleAlign .c10.c10 {
  display: block;
  height: auto;
  min-height: 0px;
}

.h_inlineBlock.h_middleAlign .c10.c10 > .c5 {
  display: block;
}

.c0 {
  position: relative;
  display: flex;
  flex-direction: column;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  border-radius: 4px;
  border: 2px solid rgb(249, 191, 48);
  background-color: rgb(255, 255, 255);
  color: rgb(77, 77, 77);
}

.c1 {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8px 16px;
}

.c11 {
  align-self: flex-start;
  display: flex;
  flex-direction: column;
  max-width: 100%;
  padding: 0px 16px 8px calc(56px);
}

.c11 > * {
  align-self: flex-start;
  max-width: 100%;
}

.c2 {
  align-items: center;
  display: inline-flex;
  flex-direction: row;
  outline: none;
}

.c4 {
  align-content: center;
  display: flex;
  margin-right: 16px;
}

.c4 .c5 {
  font-size: 1.5rem;
}

.c8 {
  line-height: 16px;
  overflow-wrap: break-word;
  word-break: break-word;
  max-width: 400px;
}

.c9 {
  margin-left: 16px;
}

@media (pointer: coarse) {
  .c10:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c10:not(:disabled):hover {
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c10:hover {
    outline: transparent solid 1px;
  }
}

@media screen and (max-width: 768px) {
  .c1 {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media screen and (max-width: 768px) {
  .c11 {
    border-top: 2px solid rgb(226, 230, 233);
    align-items: flex-start;
  }
}

@media screen and (max-width: 768px) {
  .c9 {
    margin-left: 40px;
  }
}

<div
  class="c0 messageBox messageBox--warning"
  data-role="messagebox"
>
  <div
    class="c1 messageBox__mainContainer"
    data-role="messagebox-main"
  >
    <div
      class="c2 messageBox__title"
      data-role="messagebox-title"
      tabindex="-1"
    >
      <span
        class="c3 -u-unseenButRead"
        data-role="hidden-text"
      >
        Warning
      </span>
      <div
        class="c4 messageBox__icon"
        data-role="messagebox-icon"
      >
        <i
          class="c5 c6 c7 plasma-icon plasma-icon--warning"
          data-role="plasma-icon"
        >
          <span
            aria-hidden="true"
          >
            warning
          </span>
        </i>
      </div>
      <div
        class="c8 messageBox__label"
        data-role="messagebox-label"
      >
        The specified attribute is not between the expected value of 0 and 100.
      </div>
    </div>
    <div
      class="c9 messageBox__action"
      data-role="messagebox-action"
    >
      <button
        class="c10 button button--secondary"
        data-role="button"
        title=""
        type="button"
      >
        <span
          data-role="button-label"
        >
          SHOW DETAILS
        </span>
      </button>
    </div>
  </div>
  <div
    class="c11 messageBox__subContainer"
    data-role="messagebox-detail"
  >
    Test warning message line
  </div>
</div>
`;
