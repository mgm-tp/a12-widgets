exports[`com.mgmtp.a12.widgets.layout.managed-master-detail > resizable-for-the-first-view 1`] = `
.c1 {
  display: flex;
  flex-wrap: wrap;
  flex-shrink: 0;
  padding: 16px 0px;
}

.c2 {
  font-family: "Open Sans", sans-serif;
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 24px;
  margin: 0px;
  padding: 4px 0px;
  -webkit-font-smoothing: antialiased;
  width: 100%;
}

.c9 {
  box-sizing: border-box;
  display: flex;
  padding: 2px 8px 8px;
  overflow: hidden;
  flex: 6 1 0%;
  min-width: 0px;
}

.c9:not(:first-child) {
  border-left-width: medium;
  border-left-style: none;
  border-left-color: currentcolor;
}

.c9:first-child {
  padding-left: 2px;
}

.c9:last-child {
  padding-right: 2px;
}

.c4 {
  box-sizing: border-box;
  display: flex;
  padding: 2px 8px 8px;
  overflow: hidden;
}

.c4:not(:first-child) {
  border-left-width: medium;
  border-left-style: none;
  border-left-color: currentcolor;
}

.c4:first-child {
  padding-left: 2px;
}

.c4:last-child {
  padding-right: 2px;
}

.c6 {
  background: rgb(255, 255, 255);
  border-radius: 0px;
  display: flex;
  flex: 1 1 auto;
  min-width: 0px;
  width: 100%;
  height: 100%;
}

.c7 {
  display: flex;
  flex: 1 1 auto;
  min-width: 0px;
  width: 100%;
  height: 100%;
}

.c3 {
  display: flex;
  flex: 1 1 auto;
  margin: 0px;
  overflow: auto;
}

.c0 {
  border-radius: 0px;
  display: flex;
  flex: 1 1 auto;
  flex-flow: column;
  height: 100%;
  overflow: hidden;
}

.c8 {
  cursor: col-resize;
  flex-shrink: 0;
  position: absolute;
  right: -16px;
  top: 0px;
  bottom: 0px;
  width: 16px;
  z-index: 1;
  user-select: none;
}

.c8::before {
  content: "";
  inset: 0px 0px 0px 5px;
  position: absolute;
  width: 6px;
}

.c10 {
  height: 100%;
  width: 100%;
}

.c5 {
  height: 100%;
  width: 100%;
  position: relative;
}

@media (pointer: fine) {
  .c8:hover::before {
    background-color: rgb(213, 0, 117);
  }
}

<div
  class="c0 masterDetailLayout"
  data-role="master-detail-layout-view"
>
  <div
    class="c1 masterDetailLayout__header"
    data-role="master-detail-header"
  >
    <p
      class="c2 masterDetailLayout__title"
      data-role="master-detail-layout-title"
    >
      title
    </p>
  </div>
  <div
    class="c3 masterDetailLayout__body"
    data-role="master-detail-layout-body"
  >
    <div
      class="c4 masterDetailLayoutPane masterDetailLayoutPane--col-6"
      data-role="master-detail-layout-pane"
      style="order: -1; opacity: 1; flex-grow: 12; transform-origin: left center; transform: none;"
    >
      <div
        class="c5"
        data-role="resizable-handler-wrapper"
      >
        <div
          class="c6"
          data-role="master-detail-layout-pane-content-wrapper"
        >
          <div
            class="c7"
            data-role="master-detail-layout-pane-content"
            style="opacity: 1;"
          >
            <p
              data-role="visibile-view-test"
            >
              View 1
            </p>
          </div>
        </div>
        <div
          class="c8"
          data-role="resizable-handler"
        />
      </div>
    </div>
    <div
      class="c9 masterDetailLayoutPane masterDetailLayoutPane--col-6"
      data-role="master-detail-layout-pane"
      style="order: 1; opacity: 0; flex-grow: 0; transform-origin: right center; transform: scaleX(0);"
    >
      <div
        class="c10"
        data-role="resizable-handler-wrapper"
      >
        <div
          class="c6"
          data-role="master-detail-layout-pane-content-wrapper"
        >
          <div
            class="c7"
