exports[`com.mgmtp.a12.widgets.layout.masterdetail > rendering-resizable-master-detail-for-the-first-view 1`] = `
.c1 {
  box-sizing: border-box;
  display: flex;
  padding: 2px 8px 8px;
  overflow: hidden;
}

.c1:not(:first-child) {
  border-left-width: medium;
  border-left-style: none;
  border-left-color: currentcolor;
}

.c1:first-child {
  padding-left: 2px;
  overflow: visible;
}

.c1:last-child {
  padding-right: 2px;
}

.c6 {
  box-sizing: border-box;
  display: flex;
  padding: 2px 8px 8px;
  overflow: hidden;
  flex: 6 1 0%;
  min-width: 0px;
}

.c6:not(:first-child) {
  border-left-width: medium;
  border-left-style: none;
  border-left-color: currentcolor;
}

.c6:first-child {
  padding-left: 2px;
}

.c6:last-child {
  padding-right: 2px;
}

.c3 {
  background: rgb(255, 255, 255);
  border-radius: 0px;
  display: flex;
  flex: 1 1 auto;
  min-width: 0px;
  width: 100%;
  height: 100%;
}

.c4 {
  display: flex;
  flex: 1 1 auto;
  min-width: 0px;
  width: 100%;
  height: 100%;
}

.c0 {
  display: flex;
  flex: 1 1 auto;
  margin: 0px;
  overflow: auto;
}

.c5 {
  cursor: col-resize;
  flex-shrink: 0;
  position: absolute;
  right: -16px;
  top: 0px;
  bottom: 0px;
  width: 16px;
  z-index: 1;
  user-select: none;
}

.c5::before {
  content: "";
  inset: 0px 0px 0px 5px;
  position: absolute;
  width: 6px;
}

.c2 {
  height: 100%;
  width: 100%;
  position: relative;
}

.c7 {
  height: 100%;
  width: 100%;
}

@media (pointer: fine) {
  .c5:hover::before {
    background-color: rgb(213, 0, 117);
  }
}

<div
  class="c0 masterDetailLayout__body"
  data-role="master-detail-layout-body"
>
  <div
    class="c1 masterDetailLayoutPane masterDetailLayoutPane--col-6"
    data-role="master-detail-layout-pane"
    style="order: 0; opacity: 1; flex-grow: 0; transform-origin: left center; transform: none;"
  >
    <div
      class="c2"
      data-role="resizable-handler-wrapper"
    >
      <div
        class="c3"
        data-role="master-detail-layout-pane-content-wrapper"
      >
        <div
          class="c4"
          data-role="master-detail-layout-pane-content"
          style="opacity: 1;"
        >
          <p
            data-role="visibile-view-test"
          >
            visible1
          </p>
        </div>
      </div>
      <div
        class="c5"
        data-role="resizable-handler"
      />
    </div>
  </div>
  <div
    class="c6 masterDetailLayoutPane masterDetailLayoutPane--col-6"
    data-role="master-detail-layout-pane"
    style="order: 1; opacity: 1; flex-grow: 6; transform-origin: right center; transform: none;"
