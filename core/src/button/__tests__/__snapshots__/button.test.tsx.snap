  gap: 4px;
  outline: none;
  text-transform: uppercase;
  min-height: 32px;
  vertical-align: middle;
  border: 2px solid transparent;
  border-radius: 0px;
  padding: 0px 8px;
  position: relative;
  background: transparent;
  color: rgb(5, 104, 174);
  box-shadow: none;
  pointer-events: none;
  overflow: visible !important;
}

.c0 .c1 {
  user-select: none;
}

.c0 .c1 {
  color: inherit;
}

.c0:not(:disabled):focus {
  outline: rgb(51, 51, 51) dotted 1px;
  background-color: rgb(255, 255, 255);
  box-shadow: none;
  color: rgb(213, 0, 117);
  text-decoration: none;
  border: 2px solid rgb(213, 0, 117);
}

.c0 .c4 {
  animation-name: k0;
  background-color: rgb(255, 255, 255);
  border-radius: inherit;
  height: auto;
  opacity: 0.9;
  inset: -2px !important;
}

