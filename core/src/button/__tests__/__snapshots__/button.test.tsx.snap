exports[`com.mgmtp.a12.widgets.button > rendering-progress-button 1`] = `
.c1 {
  border: 0px;
  clip: rect(0px, 0px, 0px, 0px);
  clip-path: inset(100%);
  height: 1px;
  min-height: 1px;
  overflow: hidden;
  padding: 0px;
  position: absolute;
  top: 0px;
  width: 1px;
  margin: -1px !important;
}

.c1 * {
  width: 1px;
  height: 1px;
}

.c3 {
  animation: 0.2s ease 0s 1 normal none running k1;
  background-color: rgba(22, 25, 29, 0.8);
  height: 100%;
  left: 0px;
  outline: none;
  overflow: hidden;
  position: absolute;
  right: 0px;
  top: 0px;
  user-select: none;
  visibility: hidden;
}

.c0 {
  align-items: center;
  cursor: pointer;
  display: inline-flex;
  justify-content: center;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  gap: 4px;
  outline: none;
  text-transform: uppercase;
  min-height: 32px;
  vertical-align: middle;
  border: 2px solid transparent;
  border-radius: 0px;
  padding: 0px 8px;
  position: relative;
  background: transparent;
  color: rgb(5, 104, 174);
  box-shadow: none;
  pointer-events: none;
  overflow: visible !important;
}

.c0:not(:disabled):focus {
  outline: rgb(51, 51, 51) dotted 1px;
  background-color: rgb(255, 255, 255);
  box-shadow: none;
  color: rgb(213, 0, 117);
  text-decoration: none;
  border: 2px solid rgb(213, 0, 117);
}

.c0 .c2 {
  animation-name: k0;
  background-color: rgb(255, 255, 255);
  border-radius: inherit;
  height: auto;
  opacity: 0.9;
  inset: -2px !important;
}

.h_inlineBlock.h_middleAlign .c0.c0 {
  display: block;
  height: auto;
  min-height: 0px;
}

@media (pointer: coarse) {
  .c0:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c0:not(:disabled):hover {
    background-color: rgb(255, 255, 255);
    box-shadow: none;
    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c0:hover {
    outline: transparent solid 1px;
  }
}

@keyframes k0 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 0.9;
  }
}

@keyframes k1 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

<button
  aria-labelledby="loading-test-loading-hidden-label loading-test-button-label"
  class="c0 button button--secondary"
  data-role="button"
  disabled=""
  id="loading-test"
  title=""
  type="button"
>
  <span
    data-role="button-label"
    id="loading-test-button-label"
  >
    In Progress
  </span>
  <span
    class="c1 -u-unseenButRead"
    data-role="hidden-text"
    id="loading-test-loading-hidden-label"
