    color: rgb(213, 0, 117);
    text-decoration: none;
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c0:hover {
    outline: transparent solid 1px;
  }
}

@keyframes k0 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 0.9;
  }
}

@keyframes k1 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

