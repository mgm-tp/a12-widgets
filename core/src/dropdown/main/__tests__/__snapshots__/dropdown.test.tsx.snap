<div
  class="c0 dropdown dropdown--light-background"
  data-role="dropdown"
  role="presentation"
  tabindex="0"
>
  <div
    class="c1 dropdown__content"
    data-role="dropdown-content"
    role="listbox"
  >
    <div
      aria-selected="true"
      class="c2 dropdown__item dropdown__item--preselected custom-class-item"
