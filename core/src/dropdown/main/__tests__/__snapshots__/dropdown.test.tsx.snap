  font-style: normal;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 1;
  text-transform: none;
  white-space: nowrap;
  overflow-wrap: normal;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizelegibility;
  font-feature-settings: "liga";
}

.c5 > span {
  display: inline-block;
}

.c5.c5 {
  max-width: unset;
}

.c9 .c4 {
  font-size: 1.125rem;
}

.c0 {
  box-shadow: rgba(22, 25, 29, 0.4) 0px 1px 2px 0px;
  display: flex;
  font-family: "Open Sans", sans-serif;
  flex-direction: column;
  outline: rgb(211, 214, 220) solid 1px;
  width: 100%;
  background-color: rgb(255, 255, 255);
}

.c0:focus {
  outline: none;
}

.c1 {
  animation: 0.1s ease 0s 1 normal none running pulse-dropdown-content;
  display: flex;
  flex-direction: column;
  max-height: 252px;
  overflow-y: auto;
}

.c6 {
  display: flex;
  align-items: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.c2 {
  box-sizing: border-box;
  display: flex;
  flex-shrink: 0;
  font-size: 0.75rem;
  line-height: 1rem;
  min-height: 24px;
  outline: none;
  padding: 4px 8px;
  position: relative;
  background-color: rgb(5, 104, 174);
  color: rgb(255, 255, 255);
}

.c2::after {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  inset: 0px;
  display: block;
  pointer-events: none;
  position: absolute;
}

.c2 .c4 {
  color: inherit;
}

.c2:focus::after {
  border: 1px dotted rgb(22, 25, 29);
  content: "";
}

.c2[data-type="multiselect-item"]:has([data-role="checkbox-input-indeterminate"]):first-child {
  font-weight: 700;
}

.c2[data-type="multiselect-item"]:not(:last-child):not(:focus)::after {
  content: "";
}

.c2[data-type="multiselect-item"]:not(:last-child):not(:focus):has([data-role="checkbox-input-indeterminate"]):not(:active):not(:hover):first-child::after {
  border-bottom: 1px solid rgb(169, 179, 188);
}

.c7 {
  box-sizing: border-box;
  color: rgb(77, 77, 77);
  display: flex;
  flex-shrink: 0;
  font-size: 0.75rem;
  line-height: 1rem;
  min-height: 24px;
  outline: none;
  padding: 4px 8px;
  position: relative;
}

.c7::after {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  inset: 0px;
  display: block;
  pointer-events: none;
  position: absolute;
}

.c7:focus::after {
  border: 1px dotted rgb(22, 25, 29);
  content: "";
}

.c7[data-type="multiselect-item"]:has([data-role="checkbox-input-indeterminate"]):first-child {
  font-weight: 700;
}

.c7[data-type="multiselect-item"]:not(:last-child):not(:focus)::after {
  content: "";
}

.c7[data-type="multiselect-item"]:not(:last-child):not(:focus):has([data-role="checkbox-input-indeterminate"]):not(:active):not(:hover):first-child::after {
  border-bottom: 1px solid rgb(169, 179, 188);
}

.c8 {
  box-sizing: border-box;
  display: flex;
  flex-shrink: 0;
  font-size: 0.75rem;
  line-height: 1rem;
  min-height: 24px;
  outline: none;
  padding: 4px 8px;
  position: relative;
  color: rgb(169, 179, 188);
  cursor: default;
  pointer-events: none;
  user-select: none;
}

.c8::after {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  inset: 0px;
  display: block;
  pointer-events: none;
  position: absolute;
}

.c8[data-type="multiselect-item"]:has([data-role="checkbox-input-indeterminate"]):first-child {
  font-weight: 700;
}

.c8[data-type="multiselect-item"]:not(:last-child):not(:focus)::after {
  content: "";
}

.c8[data-type="multiselect-item"]:not(:last-child):not(:focus):has([data-role="checkbox-input-indeterminate"]):not(:active):not(:hover):first-child::after {
  border-bottom: 1px solid rgb(169, 179, 188);
}

.c10 .c4 {
  color: inherit;
}

.c3 {
  align-items: center;
  display: flex;
  height: 16px;
  margin: 4px 8px 4px 0px;
}

.c3 .c4 {
  color: inherit;
}

.c11 .c4 {
  color: inherit;
}

@media (pointer: coarse) {
  .c2:not([data-type="icon-selected"]):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: transparent;
    color: rgb(77, 77, 77);
  }

  .c2:not([data-type="icon-selected"]):active::after {
    border: 2px solid rgb(213, 0, 117);
    content: "";
  }
}

@media (pointer: fine) {
  .c2:not([data-type="icon-selected"]):hover {
    cursor: pointer;
    background-color: transparent;
    color: rgb(77, 77, 77);
  }

  .c2:not([data-type="icon-selected"]):hover::after {
    border: 2px solid rgb(213, 0, 117);
    content: "";
  }
}

@media (pointer: coarse) {
