.c0 {
  display: inline-block;
}

.c1 {
  box-sizing: border-box;
  display: flex;
  isolation: isolate;
  position: relative;
  outline: none;
  width: fit-content;
}

.c1.c1 .c8 {
  background: transparent;
  border-color: transparent;
}

