exports[`com.mgmtp.a12.widgets.simple.toggle > rendering-default-simple-toggle 1`] = `
.c4 {
  box-sizing: border-box;
  color: rgb(127, 140, 155);
  display: inline-block;
  direction: ltr;
  font-family: "Material Symbols Outlined";
  font-variation-settings: "FILL" 1, "wght" 400, "GRAD" 0, "opsz" 24;
  font-size: 1rem;
  font-style: normal;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 1;
  text-transform: none;
  white-space: nowrap;
  overflow-wrap: normal;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizelegibility;
  font-feature-settings: "liga";
}

.c4 > span {
  display: inline-block;
}

.c4.c4 {
  max-width: unset;
}

.c5 {
  display: flex;
  gap: 2px;
  list-style-type: none;
  margin: 0px;
  padding: 0px;
}

.c5 .c8 {
  outline: none;
  z-index: 0;
}

.c6 {
  display: flex;
}

.c6:first-of-type {
  border-top-left-radius: 3px;
  border-bottom-left-radius: 3px;
}

.c6:first-of-type .c11 {
  padding-left: 8px;
}

.c6:last-child {
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
}

.c6:last-child .c11 {
  padding-right: 8px;
}

.c12 {
  align-items: center;
  border-radius: inherit;
  display: flex;
  justify-content: center;
  flex-grow: 1;
  min-height: 30px;
  padding: 0px 8px;
  position: relative;
}

.c2 {
  align-items: center;
  background: rgb(241, 242, 244);
  border: 2px solid transparent;
  border-radius: 3px;
  box-sizing: border-box;
  display: flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  justify-content: center;
  min-height: 32px;
  pointer-events: none;
  position: absolute;
  width: 100%;
  z-index: 1;
}

.c2 .c3 {
  color: rgb(5, 104, 174);
  user-select: none;
}

.c2:focus {
  border-color: rgb(213, 0, 117);
  cursor: pointer;
  outline: rgb(51, 51, 51) dotted 1px;
}

.c9 {
  position: relative;
  background-color: rgb(241, 242, 244);
  color: rgb(5, 104, 174);
  cursor: pointer;
  display: inline-flex;
  flex-direction: column;
  flex-shrink: 0;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  margin: 0px;
  padding: 0px;
  min-height: 32px;
  line-height: 1.45;
  border: 1px solid transparent;
  border-radius: inherit;
}

.c9::before {
  inset: -1px;
  content: "";
  position: absolute;
  border-radius: inherit;
}

.c9 .c3 {
  text-decoration: none;
  color: inherit;
  user-select: none;
}

.c9[disabled] {
  border-width: medium;
  border-style: none;
  border-color: currentcolor;
  border-image: initial;
  cursor: default;
}

.c9:not(:disabled):focus {
  outline: none;
  text-decoration: underline;
}

.c10 {
  outline: transparent solid 2px;
  z-index: 1;
  background-color: rgb(5, 104, 174);
  color: rgb(255, 255, 255);
  box-shadow: none;
  border-right: 1px solid rgb(5, 104, 174);
  border-top-color: rgb(5, 104, 174);
  border-bottom-color: rgb(5, 104, 174);
  border-left-color: rgb(5, 104, 174);
}

.c10 + .c7 {
  border-left: 0px;
}

.c10:not(:disabled):focus {
  background-color: rgb(213, 0, 117);
  color: rgb(255, 255, 255);
  box-shadow: none;
  border-right: 1px solid rgb(213, 0, 117);
  border-top-color: rgb(213, 0, 117);
  border-bottom-color: rgb(213, 0, 117);
  border-left-color: rgb(213, 0, 117);
}

.c10:not(:disabled):focus::before {
  outline: rgb(51, 51, 51) dotted 1px;
}

.c10:not(:disabled):focus + .c7 {
  border-left: 0px;
}

.c10:last-child {
  border-color: rgb(5, 104, 174);
}

.c13:not(:disabled):focus {
  color: rgb(213, 0, 117);
}

.c13:not(:disabled):focus::before {
  outline: rgb(51, 51, 51) dotted 1px;
}

.c13:not(:disabled):focus::before {
  border: 2px solid rgb(213, 0, 117);
  z-index: 1;
}

.c0 {
  display: inline-block;
}

.c1 {
  box-sizing: border-box;
  display: flex;
  isolation: isolate;
  position: relative;
  outline: none;
  width: fit-content;
}

.c1.c1 .c8 {
  background: transparent;
  border-color: transparent;
}

.c1.c1 .c8::before {
  border-color: transparent;
}

@media (pointer: coarse) {
