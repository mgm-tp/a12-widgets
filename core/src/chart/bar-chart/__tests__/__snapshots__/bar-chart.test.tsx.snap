// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`com.mgmtp.a12.widgets.charts > render bar chart with different categories 1`] = `
<div
  class="recharts-wrapper barChart"
  style="position: relative; cursor: default; width: 600px; height: 300px;"
>
  <svg
    class="recharts-surface"
    height="300"
    style="width: 100%; height: 100%;"
    viewBox="0 0 600 300"
    width="600"
  >
    <title />
    <desc />
    <defs>
      <clippath
        id="recharts6-clip"
      >
        <rect
          height="242"
          width="590"
          x="5"
          y="5"
        />
      </clippath>
    </defs>
    <g
      class="recharts-layer recharts-bar"
    >
      <g
        class="recharts-layer recharts-bar-rectangles"
      >
        <g
          class="recharts-layer"
        >
          <g
            class="recharts-layer recharts-bar-rectangle"
          />
          <g
            class="recharts-layer recharts-bar-rectangle"
          />
          <g
            class="recharts-layer recharts-bar-rectangle"
          />
        </g>
      </g>
    </g>
    <g
      class="recharts-layer recharts-cartesian-axis recharts-xAxis xAxis"
    >
      <line
        class="recharts-cartesian-axis-line"
        fill="none"
        height="48"
        orientation="bottom"
        stroke="#8c99a6"
        width="590"
        x="5"
        x1="5"
        x2="595"
        y="247"
        y1="247"
        y2="247"
      />
      <g
        class="recharts-cartesian-axis-ticks"
      />
    </g>
  </svg>
  <div
    class="recharts-tooltip-wrapper recharts-tooltip-wrapper-right recharts-tooltip-wrapper-bottom"
    style="visibility: hidden; pointer-events: none; position: absolute; top: 0px; left: 0px; transform: translate(10px, 10px);"
    tabindex="-1"
  >
    <div
      class="recharts-default-tooltip"
      style="margin: 0px; padding: 10px; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); white-space: nowrap;"
    >
      <p
        class="recharts-tooltip-label"
        style="margin: 0px;"
      />
    </div>
  </div>
</div>
`;

