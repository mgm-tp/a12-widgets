@keyframes k0 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

@keyframes k1 {
  0% {
    bottom: -100px;
    opacity: 0;
  }

  100% {
    bottom: 0px;
    opacity: 1;
  }
}

@keyframes k2 {
  0% {
    bottom: 0px;
    opacity: 1;
  }

  100% {
    bottom: -100px;
    opacity: 0;
