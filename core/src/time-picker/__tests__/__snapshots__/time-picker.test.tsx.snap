  .c27.c27:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c27.c27:not(:disabled):hover {
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c39:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c39:hover {
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: coarse) {
  .c40:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c40:hover {
    border: 2px solid rgb(213, 0, 117);
  }
}

