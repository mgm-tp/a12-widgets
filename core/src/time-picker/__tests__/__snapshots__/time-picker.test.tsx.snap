                      data-role="time-picker-time"
                    >
                      02
                    </span>
                    :
                    <span
                      class="c36 TimePicker__time"
                      data-role="time-picker-time"
                    >
                      00
                    </span>
                  </div>
                  <span
                    class="c37 TimePicker__am "
                    data-role="time-picker-am"
                  >
                    am
                  </span>
                  <span
                    class="c38 TimePicker__pm TimePicker__pm--selected"
                    data-role="time-picker-pm"
                  >
                    pm
                  </span>
                </div>
              </div>
              <div
                class="c39 picker-footer TimePicker__footer"
                data-role="picker-footer"
              >
                <div
                  class="c40 picker-footer__action"
                  data-role="picker-footer-action"
                />
                <div
                  class="c40 picker-footer__action"
                  data-role="picker-footer-action"
