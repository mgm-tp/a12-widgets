exports[`com.mgmtp.a12.widgets.rich-text-editor.auto-link-plugin > Should handle Not links 1`] = `
HTMLCollection [
  <p
    class="editor-paragraph ltr"
    dir="ltr"
  >
    <span
      data-lexical-text="true"
    >
      example.invalid
example.invalid/
http://.example.com
http://-example.com
hppt://example.com
example.coma
-example.coma
foo.123
localhost           % only with protocol allowed
localhost/
///localhost        % 3 '/' not allowed
///test.com
//test              % Don't allow single level protocol-less domains to avoid false positives
_http://example.com
_//example.com
_example.com
http://example.com_
@example.com
node.js and io.js
http://
http://.
http://..
http://#
http://##
http://?
http://??
google.com:500000 // invalid port
show image.jpg
path:to:file.pm
/path/to/file.pl
foo@bar     % Should be at second level domain & with correct tld
mailto:bar
    </span>
  </p>,
]
`;

