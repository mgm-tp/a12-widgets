    transform: translate3d(0px, -3px, 0px);
  }

  100% {
    transform: translateZ(0px);
  }
}

<div>
  <div
    class="c0 field-wrapper field-wrapper--block "
    data-role="textline"
  >
    <div
      class="c1 c2 field__main"
    >
      <div
        class="c3 c4 field"
        data-role="textline-control"
      >
        <div
          class="c5 c6 field__input"
          data-role="textline-input-wrapper"
        >
          <div
            class="c7 c8 field__prefix field__prefix--last"
            data-role="textline-prefix-0"
          >
            <button
              aria-label="Select a date"
              aria-labelledby="test-date-input-trigger-button-title"
              class="c9 c10 button button--icon button--block"
              data-role="button"
              data-type="icon"
              id="test-date-input-trigger-button"
              title="Select a date"
              type="button"
            >
              <i
                class="c11 c12 plasma-icon"
                data-role="plasma-icon"
              >
                <span
                  aria-hidden="true"
                >
                  event
                </span>
              </i>
              <span
                class="c13 -u-unseenButRead"
                data-role="hidden-text"
                id="test-date-input-trigger-button-title"
              >
                , Select a date
              </span>
            </button>
          </div>
          <span
            class="c14 supported-unseen-span"
          />
          <input
            class="c15 field__text"
            data-role="textline-input"
            id="test-date-input-input"
            type="text"
            value=""
          />
          <span
            class="c14 supported-unseen-span"
          />
        </div>
      </div>
    </div>
