            </span>
          </button>
        </div>
        <span
          class="c14 supported-unseen-span"
        />
        <input
          class="c15 field__text"
          data-role="textline-input"
          id="test-date-input-input"
          readonly=""
          tabindex="-1"
          type="text"
          value=""
        />
        <span
          class="c14 supported-unseen-span"
        />
      </div>
    </div>
  </div>
</div>
`;
