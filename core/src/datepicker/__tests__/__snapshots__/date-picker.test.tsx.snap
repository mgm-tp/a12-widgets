<div
  class="c0 DayPicker-root"
  data-role="date-picker-root"
  tabindex="-1"
>
  <div
    class="DayPicker c1 DayPicker-Range"
    data-mode="range"
    data-required="false"
    data-role="date-picker"
    lang="en-US"
  >
    <div
      class="DayPicker-Months"
    >
      <div
        class="DayPicker-Month"
      >
        <div
          class="c2"
          data-role="date-picker-nav-bar"
        >
          <button
            aria-label="Previous Month"
            class="c3 c4 button button--icon button--outline button--dark c5 c6 DayPicker-NavButton DayPicker-NavButton--prev"
            data-role="date-picker-nav-bar-prev"
            data-type="icon"
            title="Previous Month"
            type="button"
          >
            <i
              class="c7 c8 plasma-icon plasma-icon--big"
              data-role="plasma-icon"
            >
              <span
                aria-hidden="true"
              >
                navigate_before
              </span>
            </i>
          </button>
          <div
            class="c9 year-month-selector c10 DayPicker-Caption"
            data-role="year-month-selector"
          >
            <div
              class="c11 year-month-selector__inner"
              data-role="year-month-selector-control"
            >
              <div
                class="c12 c13 field field--block month-selector"
                data-role="month-selector"
              >
                <label
                  class="c14 c15 label field__label -u-unseenButRead"
                  data-role="month-selector-label"
                >
                  Month
                </label>
                <div
                  class="c16 c17 field__select"
                  data-role="month-selector-control"
                >
                  <div
                    class="c18 c19 field__select-wrapper"
                    data-role="month-selector-wrapper"
                  >
                    <select
                      class="c20 c21 field__selectTitle"
                      data-role="month-selector-input"
                    >
                      <option
