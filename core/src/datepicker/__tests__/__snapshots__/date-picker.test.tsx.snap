  border-radius: 0px;
  font-size: 0.875rem;
  user-select: none;
}

.c0 .DayPicker-Week .DayPicker-Day-Cell {
  padding: 4px 0px 0px;
}

.c0 .DayPicker-Week .DayPicker-Day-Cell:first-child {
  padding-left: 0px;
}

.c0 .DayPicker-Week .DayPicker-Day-Cell:last-child {
  padding-right: 0px;
}

.c0 .DayPicker-Weekday {
  color: rgb(77, 77, 77);
  font-size: 0.875rem;
  font-weight: 700;
  line-height: normal;
  padding: 24.5px 0px calc(12.5px);
  text-align: center;
  width: 32px;
  text-decoration: underline dotted;
  text-transform: lowercase;
}

.c0 .DayPicker-Weekday::first-letter {
  text-transform: uppercase;
}

.c4 {
  height: 32px;
  width: 32px;
}

.c1 {
  align-items: center;
  background-color: rgb(78, 89, 101);
  display: flex;
  justify-content: space-evenly;
}

.c8 {
  align-items: center;
  display: flex;
  font-weight: 700;
  justify-content: center;
  height: 48px;
}

.c8 .c17 {
  background-color: rgb(89, 102, 115);
  border: 2px solid transparent;
  color: rgb(255, 255, 255);
  height: 32px;
  padding: 0px 32px 0px 8px;
  box-shadow: none;
  border-radius: 2px;
}

.c8 .c17:focus {
  background-color: rgba(0, 0, 0, 0.2);
  border: 2px solid rgb(255, 255, 255);
}

.c8 .c13 {
  height: auto;
}

.c8 .c21::after {
  content: "";
  color: rgb(255, 255, 255);
  font-size: 1.25rem;
  width: 32px;
}

.c8 .c15 {
  background-color: transparent;
  box-shadow: none;
  outline-offset: unset;
}

.c8 .c15::before {
  display: none;
}

.c8 .c15:focus-within {
  outline: rgb(255, 255, 255) dotted 1px;
}

.c8 .c19 {
  background-color: rgb(255, 255, 255);
  color: rgb(77, 77, 77);
}

.c8 [data-role="year-selector"] {
  display: inline-block;
  flex-shrink: 0;
  margin: 0px;
  width: calc(72px);
}

.c23 {
  height: 32px;
  width: 32px;
}

@media (pointer: fine) {
  .c2:hover {
    outline: transparent solid 1px;
  }
}

@media (pointer: coarse) {
  .c2:not([data-role^="quick-access-button"]):not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c2:not([data-role^="quick-access-button"]):not(:disabled):hover {
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c16:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: fine) {
  .c16:hover {
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: coarse) {
  .c20:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(213, 0, 117);
    color: rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c20:hover {
    background-color: rgb(213, 0, 117);
    color: rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c3.c3:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
