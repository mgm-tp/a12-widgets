  color: rgb(255, 255, 255);
  border: 2px solid rgb(255, 255, 255);
}

.c26 {
  align-items: center;
  border: 2px solid transparent;
  border-radius: 50%;
  cursor: pointer;
  display: inline-flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  justify-content: center;
  height: 32px;
  line-height: normal;
  margin: 0px;
  width: 32px;
  background-color: rgb(255, 255, 255);
  color: rgb(77, 77, 77);
}

.c26:focus {
  outline: rgb(51, 51, 51) dotted 1px;
  border: 2px solid rgb(213, 0, 117);
  background-color: rgb(255, 255, 255);
}

.c27 {
  align-items: center;
  border: 2px solid transparent;
  cursor: pointer;
  display: inline-flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  justify-content: center;
  height: 32px;
  line-height: normal;
  margin: 0px;
  width: 32px;
  color: rgb(77, 77, 77);
  background-color: rgb(226, 230, 233);
  border-radius: 50%;
  font-weight: 700;
}

.c27:focus {
  outline: rgb(51, 51, 51) dotted 1px;
  border: 2px solid rgb(213, 0, 117);
}

.c0 {
  outline: transparent solid 1px;
  -webkit-tap-highlight-color: transparent;
  justify-content: center;
  user-select: none;
}

.c0 * {
  outline: none;
}

.c0 .DayPicker-Months {
  box-shadow: rgba(22, 25, 29, 0.4) 0px 1px 2px 0px;
}

.c0 .DayPicker-Table {
  padding: 0px 14px 24px;
  border-spacing: 4px 0px;
}

.c0 .DayPicker-Body {
  color: rgb(77, 77, 77);
}

.c0 .DayPicker-Month {
  background-color: rgb(255, 255, 255);
  border-radius: 0px;
  font-size: 0.875rem;
  user-select: none;
}

.c0 .DayPicker-Week .DayPicker-Day-Cell {
  padding: 4px 0px 0px;
}

.c0 .DayPicker-Week .DayPicker-Day-Cell:first-child {
  padding-left: 0px;
}

.c0 .DayPicker-Week .DayPicker-Day-Cell:last-child {
  padding-right: 0px;
}

.c0 .DayPicker-Weekday {
  color: rgb(77, 77, 77);
  font-size: 0.875rem;
  font-weight: 700;
  line-height: normal;
  padding: 24.5px 0px calc(12.5px);
  text-align: center;
  width: 32px;
  text-decoration: underline dotted;
  text-transform: lowercase;
}

.c0 .DayPicker-Weekday::first-letter {
  text-transform: uppercase;
}

.c5 {
  height: 32px;
  width: 32px;
}

.c1 {
  align-items: center;
  background-color: rgb(78, 89, 101);
  display: flex;
  justify-content: space-evenly;
}

.c9 {
  align-items: center;
  display: flex;
  font-weight: 700;
  justify-content: center;
  height: 48px;
}

.c9 .c19 {
  background-color: rgb(89, 102, 115);
  border: 2px solid transparent;
  color: rgb(255, 255, 255);
  height: 32px;
  padding: 0px 32px 0px 8px;
  box-shadow: none;
  border-radius: 2px;
}

.c9 .c19:focus {
  background-color: rgba(0, 0, 0, 0.2);
  border: 2px solid rgb(255, 255, 255);
}

.c9 .c15 {
  height: auto;
}

.c9 .c23::after {
  content: "";
  color: rgb(255, 255, 255);
  font-size: 1.25rem;
  width: 32px;
}

.c9 .c17 {
  background-color: transparent;
  box-shadow: none;
  outline-offset: unset;
}

.c9 .c17::before {
  display: none;
}

.c9 .c17:focus-within {
  outline: rgb(255, 255, 255) dotted 1px;
}

.c9 .c21 {
  background-color: rgb(255, 255, 255);
  color: rgb(77, 77, 77);
}

.c9 [data-role="year-selector"] {
  display: inline-block;
  flex-shrink: 0;
  margin: 0px;
  width: calc(72px);
}

.c25 {
  height: 32px;
  width: 32px;
}

@media (pointer: fine) {
  .c3:hover {
    outline: transparent solid 1px;
  }
}

@media (pointer: coarse) {
  .c3:not([data-role^="quick-access-button"]):not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c3:not([data-role^="quick-access-button"]):not(:disabled):hover {
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c18:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: fine) {
  .c18:hover {
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: coarse) {
  .c22:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgb(213, 0, 117);
    color: rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c22:hover {
    background-color: rgb(213, 0, 117);
    color: rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c4.c4:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c4.c4:not(:disabled):hover {
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c26:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    border: 2px solid rgb(213, 0, 117);
    background-color: rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c26:hover {
    border: 2px solid rgb(213, 0, 117);
    background-color: rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c27:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c27:hover {
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: coarse) {
  .c9 .c19:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    border: 2px solid rgb(5, 104, 174);
  }
}

@media (pointer: fine) {
  .c9 .c19:hover {
    background-color: rgba(0, 0, 0, 0.2);
