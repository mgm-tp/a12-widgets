}

.h_inlineBlock.h_middleAlign .c30.c30 > .c6 {
  display: block;
}

.c14 {
  color: rgb(77, 77, 77);
  display: inline-block;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  line-height: 1.45;
  text-transform: none;
  align-self: center;
  border: 0px;
  clip: rect(0px, 0px, 0px, 0px);
  clip-path: inset(100%);
  height: 1px;
  min-height: 1px;
  overflow: hidden;
  padding: 0px;
  position: absolute;
  top: 0px;
  width: 1px;
  margin: -1px !important;
}

.c14:empty {
  display: none;
}

.c14 * {
  width: 1px;
  height: 1px;
}

.c32 .c2 {
  border-radius: 0px;
}

.c12 {
