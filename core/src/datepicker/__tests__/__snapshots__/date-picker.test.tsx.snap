exports[`com.mgmtp.a12.widgets.date-picker with timezone Pacific/Kiritimati > test date picker classNames — select year selector 1`] = `
.c7 {
  box-sizing: border-box;
  color: rgb(127, 140, 155);
  display: inline-block;
  direction: ltr;
  font-family: "Material Symbols Outlined";
  font-variation-settings: "FILL" 1, "wght" 400, "GRAD" 0, "opsz" 24;
  font-size: 1rem;
  font-style: normal;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 1;
  text-transform: none;
  white-space: nowrap;
  overflow-wrap: normal;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizelegibility;
  font-feature-settings: "liga";
}

.c7 > span {
  display: inline-block;
}

.c7.c7 {
  max-width: unset;
}

.c3 {
  align-items: center;
  border: 2px solid transparent;
  cursor: pointer;
  display: inline-flex;
  justify-content: center;
  font-family: "Open Sans", sans-serif;
  font-weight: 700;
  gap: 4px;
  outline: none;
  position: relative;
  text-transform: uppercase;
  vertical-align: middle;
  border-radius: 50%;
  flex-shrink: 0;
  font-size: 1.125rem;
  height: 2rem;
  min-height: 0px;
  padding: 0px;
  width: 2rem;
}

.c3 .c6 {
  user-select: none;
}

.c3 .c6 {
  color: inherit;
}

.c3 .c6 {
  font-size: inherit;
}

.c3:not([data-role^="quick-access-button"]) {
  border-radius: 50%;
  background: transparent;
  color: rgb(255, 255, 255);
}

.c3:not([data-role^="quick-access-button"]):not(:disabled):focus {
  outline: rgb(255, 255, 255) dotted 1px;
  background-color: rgba(0, 0, 0, 0.2);
  box-shadow: none;
  color: rgb(255, 255, 255);
  border: 2px solid rgb(255, 255, 255);
}

.h_inlineBlock.h_middleAlign .c3.c3 {
  display: block;
  height: auto;
  min-height: 0px;
}

.h_inlineBlock.h_middleAlign .c3.c3 > .c6 {
  display: block;
}

.c28 .c6 {
  user-select: none;
}

.c28 .c6 {
  color: inherit;
