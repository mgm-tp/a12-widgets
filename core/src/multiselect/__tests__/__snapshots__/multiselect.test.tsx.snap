              data-role="text-field-suffix-0"
            >
              <i
                aria-hidden="true"
                class="c20 c21 plasma-icon plasma-icon--big c22"
                data-role="selection-suffix"
              >
                <span
                  aria-hidden="true"
                >
                  expand_more
                </span>
              </i>
            </div>
          </div>
        </div>
      </div>
