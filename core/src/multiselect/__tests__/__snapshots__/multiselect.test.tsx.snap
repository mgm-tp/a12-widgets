}

.c29 .c30 .c42 {
  padding: 24px 24px 0px;
}

.c47 {
  margin: 2px 0px 0px;
}

@media (pointer: coarse) {
  .c40:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: transparent;
    box-shadow: none;
    color: rgb(213, 0, 117);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c40:not(:disabled):hover {
    background-color: transparent;
    box-shadow: none;
    color: rgb(213, 0, 117);
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c40:hover {
    outline: transparent solid 1px;
  }
}

@media only screen and (max-width: 756px) {
  .c31 {
    width: 100%;
  }
}

@media (pointer: coarse) {
  .c41.c41:not(:disabled):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: fine) {
  .c41.c41:not(:disabled):hover {
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    color: rgb(255, 255, 255);
    border: 2px solid rgb(255, 255, 255);
  }
}

@media (pointer: coarse) {
  .c10:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: fine) {
  .c10:hover {
    box-shadow: rgb(213, 0, 117) 0px 2px 0px 0px;
  }
}

@media (pointer: coarse) {
  .c57:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c57:active + label > span::before {
    inset: -1px;
  }
}

@media (pointer: fine) {
  .c57:hover + label > span::before {
    inset: -1px;
  }
}

@media (pointer: coarse) {
  .c58:active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c58:active + label > span::before {
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c58:hover + label > span::before {
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c58 + label:hover > span::after {
    background-color: rgb(213, 0, 117);
  }

  .c58 + label:hover > span::before {
    border: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: coarse) {
  .c50:not([data-type="icon-selected"]):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c50:not([data-type="icon-selected"]):active::after {
    border: 2px solid rgb(213, 0, 117);
    content: "";
  }
}

@media (pointer: fine) {
  .c50:not([data-type="icon-selected"]):hover {
    cursor: pointer;
  }

  .c50:not([data-type="icon-selected"]):hover::after {
    border: 2px solid rgb(213, 0, 117);
    content: "";
  }
}

@media (pointer: coarse) {
  .c50[data-type="multiselect-item"]:not(:last-child):not(:focus):active {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  .c50[data-type="multiselect-item"]:not(:last-child):not(:focus):active::after {
    border-bottom: 2px solid rgb(213, 0, 117);
  }
}

@media (pointer: fine) {
  .c50[data-type="multiselect-item"]:not(:last-child):not(:focus):hover::after {
    border-bottom: 2px solid rgb(213, 0, 117);
  }
}

@keyframes k2 {
  0% {
    transform: translate3d(0px, -3px, 0px);
  }

  100% {
    transform: translateZ(0px);
  }
}

@keyframes k1 {
  0% {
    transform: translate3d(0px, 3px, 0px);
  }

  100% {
    transform: translateZ(0px);
  }
}

@keyframes k0 {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

<div>
  <div
    class="c0 multiselect"
    data-role="multiselect"
    id="test-id"
  >
    <div
      class="c1 field-wrapper field-wrapper--block multiselect__input"
      data-role="text-field"
    >
      <div
        class="c2 c3 field__main"
      >
        <div
          class="c4 c5 field"
          data-role="text-field-control"
        >
          <label
            class="c6 c7 label field__label"
            data-role="text-field-label"
            for="test-id-multiselect__input"
            id="test-id-multiselect__input-label"
          >
            Test Multiselect
            <span
              class="c8 -u-unseenButRead"
              data-role="hidden-text"
            >
              , Test Placeholder
            </span>
          </label>
          <div
            aria-describedby="test-id-multiselect__input test-id-multiselect__input-label"
            aria-expanded="false"
            aria-haspopup="listbox"
            aria-placeholder="Test Placeholder"
            class="c9 c10 field__input"
            data-isfocused="false"
            data-role="text-field-input-wrapper"
            id="test-id-multiselect__input-wrapper"
            role="combobox"
            tabindex="0"
          >
            <div
              class="c11 field__prefix field__prefix--last"
              data-role="text-field-prefix-0"
            >
              <span
                class="c12 c13 counter multiselect__counter"
                data-role="counter"
                id="test-id-counter"
              >
                <span
                  class="c14 -u-unseenButRead"
                  data-role="hidden-text"
                >
                  0 Entries
                </span>
                <span
                  aria-hidden="true"
                  role="presentation"
                >
                  <span
                    class="c15 counter__item"
                  >
