}

.c12 > span {
  display: inline-block;
}

.c12.c12 {
  max-width: unset;
}

.c13.c13 {
  color: rgb(201, 29, 29);
}

.c20 {
  align-items: center;
  background-color: rgb(183, 192, 199);
  border-radius: 8px;
  color: rgb(77, 77, 77);
  display: inline-flex;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  justify-content: center;
  outline: transparent solid 1px;
  padding: 0px 5px;
  vertical-align: middle;
}

.c20 > * {
  flex-shrink: 0;
}

.c21 {
  height: auto;
  line-height: 1rem;
  margin: 0px;
  padding: 0px;
  animation: 0.5s ease 0s 1 normal none running k0, 0.5s ease 0s 1 normal none running k1;
}

.c7 {
  color: rgb(77, 77, 77);
  display: inline-block;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  line-height: 1.45;
  text-transform: none;
  margin: 0px 0px 4px;
  align-self: center;
}

.c7:empty {
