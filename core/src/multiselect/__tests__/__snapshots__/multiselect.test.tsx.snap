  margin-right: 4px;
}

.c10 .c11 {
  font-size: 1.25rem;
}

.c15 {
  align-self: center;
  max-width: calc(100% - 4px - 1.25rem);
}

.c27 {
  color: rgb(127, 140, 155);
  user-select: none;
  cursor: pointer;
}

.c31 {
  color: rgb(97, 111, 124);
  display: block;
  font-family: "Open Sans", sans-serif;
  font-size: 0.75rem;
  line-height: 1.25;
  margin: 4px 0px 0px;
  width: fit-content;
}

.c29 {
