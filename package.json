		"prepare": "husky"
	},
	"devDependencies": {
		"@com.mgmtp.a12.devtools/tsconfig": "^2.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tony.ganchev/eslint-plugin-header": "^3.4.4",
		"@types/node": "catalog:",
		"@types/unzipper": "^0.10.11",
		"eslint": "^10.10.0",
		"eslint-plugin-storybook": "^10.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "catalog:",
		"unzipper": "^0.12.5"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"oxfmt",
			"oxlint --quiet --fix --disable-nested-config"
