{
	"name": "root",
	"private": true,
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
	"scripts": {
		"compile": "pnpm -r compile",
		"clean": "pnpm -r clean",
		"start": "pnpm -r --parallel start",
		"test": "pnpm -r test",
		"lint": "pnpm \"/^lint:.*/\"",
		"lint:eslint": "pnpm -r --parallel --no-bail lint:eslint",
		"lint:prettier": "prettier . --check",
		"lint:detect-cycle": "devtools detect-cycles \"./{core,utils,new-showcase}/src/**/*.@(ts|tsx)\"",
		"format": "pnpm \"/format:/\"",
		"format:eslint": "pnpm lint:eslint --fix",
		"format:prettier": "prettier . --write",
		"prepare": "husky"
	},
	"devDependencies": {
		"@com.mgmtp.a12.devtools/build-tools": "^1.1.0",
		"@com.mgmtp.a12.devtools/eslint-config": "^3.1.0",
		"@com.mgmtp.a12.devtools/prettier-config": "^1.1.0",
		"@com.mgmtp.a12.devtools/tsconfig": "^1.1.0",
		"@stylistic/eslint-plugin": "5.6.1",
		"@types/unzipper": "^0.10.11",
		"eslint": "^9.39.4",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-notice": "^1.0.0",
		"eslint-plugin-react-refresh": "^0.4.26",
		"eslint-plugin-storybook": "^10.3.5",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.2",
		"typescript": "5.8.2",
		"typescript-eslint": "^8.58.1",
		"unzipper": "^0.12.3"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"version": "38.3.6",
	"a12Version": "2025.06-ext7",
	"type": "module"
}
