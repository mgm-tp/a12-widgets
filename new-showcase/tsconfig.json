{
	"extends": "./node_modules/@com.mgmtp.a12.devtools/tsconfig/tsconfig.json",
	"exclude": ["node_modules"],
	"include": ["./src"],
	"compilerOptions": {
		"declaration": false,
		"declarationMap": false,
		"incremental": true,
		"noEmit": true,
		"noUncheckedSideEffectImports": false,
		"rootDir": ".",
		"tsBuildInfoFile": "target/tsconfig.tsbuildinfo",
		"lib": ["DOM", "ESNext"],
		"typeRoots": ["./node_modules/@types", "./src/@types"],
		"types": ["node"]
	}
}
