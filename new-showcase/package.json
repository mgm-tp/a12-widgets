	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"browserslist": [
		"last 2 firefox versions",
		"Firefox ESR",
		"last 2 chrome versions",
		"last 2 edge versions",
		"last 2 ios versions",
		"last 2 Safari versions",
		"last 2 ChromeAndroid versions"
	],
	"scripts": {
		"clean": "rimraf public-showcase target",
		"lint:eslint": "eslint --quiet --cache --cache-location target/.eslintcache",
		"start": "pnpm \"/^start:.*/\"",
		"start:showcase": "rsbuild dev --host",
		"start:typescript": "tsgo --watch --preserveWatchOutput",
		"compile": "pnpm \"/^compile:.*/\"",
		"compile:showcase": "rsbuild build",
		"compile:typescript": "tsgo -b"
	},
