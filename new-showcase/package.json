{
	"name": "@com.mgmtp.a12.widgets/widgets-showcase-redesign",
	"version": "39.1.0",
	"description": "Showcase of Widgets - Redesigned",
	"author": "mgm technology partners",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"browserslist": [
		"last 2 firefox versions",
		"Firefox ESR",
		"last 2 chrome versions",
		"last 2 edge versions",
		"last 2 ios versions",
		"last 2 Safari versions",
		"last 2 ChromeAndroid versions"
	],
	"scripts": {
		"clean": "rimraf public-showcase target",
		"check:live-modules": "node scripts/check-live-modules.mjs",
		"gen:editor-types": "node scripts/gen-editor-types.mjs",
		"gen:playground-sources": "node scripts/gen-playground-sources.mjs",
		"gen:sandbox-fonts": "node scripts/gen-sandbox-fonts.mjs",
		"gen:widgets-core-types": "node scripts/gen-widgets-core-types.mjs",
		"prepare:showcase-assets": "node scripts/gen-widgets-core-types.mjs && node scripts/gen-editor-types.mjs && node scripts/gen-sandbox-fonts.mjs && node scripts/gen-playground-sources.mjs",
		"start": "pnpm \"/^start:.*/\"",
		"start:showcase": "pnpm prepare:showcase-assets && rsbuild dev --host",
		"start:typescript": "tsgo --watch --preserveWatchOutput",
		"compile": "pnpm \"/^compile:.*/\"",
		"compile:showcase": "pnpm prepare:showcase-assets && rsbuild build",
		"compile:typescript": "tsgo -b"
	},
	"dependencies": {
		"@com.mgmtp.a12.devtools/tsconfig": "^2.0.1",
		"@com.mgmtp.a12.widgets/widgets-core": "workspace:^",
		"@com.mgmtp.a12.widgets/widgets-json-api": "workspace:^",
		"@com.mgmtp.a12.widgets/widgets-utils": "workspace:^",
		"@date-fns/tz": "catalog:",
		"@faker-js/faker": "^10.6.0",
		"@lexical/link": "catalog:",
		"@lexical/list": "catalog:",
		"@lexical/mdast": "catalog:",
		"@lexical/react": "catalog:",
		"@lexical/utils": "catalog:",
		"@monaco-editor/react": "^4.7.0",
		"@rsbuild/core": "2.2.3",
		"@rsbuild/plugin-react": "2.1.0",
		"@rsbuild/plugin-styled-components": "1.7.0",
		"@rspack/core": "2.2.2",
		"@types/lodash-es": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/react-transition-group": "catalog:",
		"@types/react-virtualized": "catalog:",
		"@typescript/native-preview": "latest",
		"date-fns": "catalog:",
		"deepmerge": "catalog:",
		"dompurify": "catalog:",
		"fflate": "^0.8.3",
		"fuzzysort": "^4.0.2",
		"immer": "catalog:",
		"lexical": "catalog:",
		"lodash-es": "catalog:",
		"lorem-ipsum": "^3.0.0",
		"mobile-detect": "catalog:",
		"monaco-editor": "^0.56.0",
		"polished": "catalog:",
		"react": "catalog:",
		"react-dnd": "catalog:",
		"react-dnd-html5-backend": "catalog:",
		"react-dom": "catalog:",
		"react-element-to-jsx-string": "^17.0.1",
		"react-is": "catalog:",
		"react-markdown": "^10.1.0",
		"react-router": "^8.4.0",
		"react-transition-group": "catalog:",
		"react-virtualized": "catalog:",
		"recharts": "catalog:",
		"remark-gfm": "^4.0.1",
		"rimraf": "catalog:",
		"source-map-loader": "^5.0.0",
		"styled-components": "catalog:",
		"sucrase": "^3.35.0",
		"ts-key-enum": "catalog:",
		"typedoc": "catalog:",
		"typescript": "catalog:"
	},
	"files": [
		"config",
		"public",
		"src",
		"lib",
		"tsconfig.json",
		"rsbuild.config.ts",
		"LICENSE",
		"NOTICE",
		"THIRD_PARTY_NOTICES",
		"licenses"
	],
	"type": "module"
}
